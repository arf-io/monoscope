# preset metadata + picker helpers (pure functions, unit-tested)
# --------------------------------------------------------------------------

def _meta_year(name, description):
    """Model year: the -19xx/-20xx suffix of the preset name, else the
    first 19xx/20xx figure in the description ('1960s' counts), else None."""
    m = re.search(r"-((?:19|20)\d{2})$", name or "")
    if m:
        return int(m.group(1))
    m = re.search(r"\b((?:19|20)\d{2})", description or "")
    return int(m.group(1)) if m else None


def _meta_price(description):
    """First $ figure in the description as a number (commas stripped;
    '$1,000 - ...' -> 1000, '$319.95' -> 319.95), or None."""
    m = re.search(r"\$\s*([0-9][\d,]*(?:\.\d+)?)", description or "")
    if not m:
        return None
    v = float(m.group(1).replace(",", ""))
    return int(v) if v.is_integer() else v


def _meta_manufacturer(name):
    """Manufacturer from the preset name: the hand map first, then the
    manufacturer-prefix table (first hyphen token, then bare prefix so
    ibm5151/applecolor resolve). None when nothing matches."""
    n = (name or "").strip().lower()
    if n in PRESET_MAKER_SPECIAL:
        return PRESET_MAKER_SPECIAL[n]
    head = n.split("-", 1)[0]
    if head in PRESET_MAKERS:
        return PRESET_MAKERS[head]
    for prefix in sorted(PRESET_MAKERS, key=len, reverse=True):
        if n.startswith(prefix):
            return PRESET_MAKERS[prefix]
    return None


def derive_preset_meta(name, description, params, family=None):
    """Structured metadata for one preset, written into its JSON as
    'meta' and consumed by the picker's details pane and sort modes.
    resolution falls back to the params.json scan_lines default (480)."""
    if family is None:
        family = PRESET_FAMILIES.get((name or "").strip().lower())
    try:
        resolution = int((params or {}).get("scan_lines", 480))
    except (TypeError, ValueError):
        resolution = 480
    return {
        "year": _meta_year(name, description),
        "type": family,
        "manufacturer": _meta_manufacturer(name),
        "price_usd": _meta_price(description),
        "resolution": resolution,
    }


def preset_sort_key(entry, mode):
    """Sort key for one picker entry ({'name','meta',...}) under `mode`.
    Missing meta / null fields always sort last; 'type' groups by family
    then name; year/price/resolution ascend; name/manufacturer are
    case-insensitive."""
    meta = entry.get("meta") or {}
    name = (entry.get("name") or "").lower()
    if mode == "name":
        return (name,)
    if mode == "type":
        fam = meta.get("type")
        return (fam is None, fam or "", name)
    if mode == "manufacturer":
        maker = meta.get("manufacturer")
        return (maker is None, (maker or "").lower(), name)
    if mode == "year":
        v = meta.get("year")
    elif mode == "price":
        v = meta.get("price_usd")
    elif mode == "resolution":
        v = meta.get("resolution")
    else:
        raise CrtError("unknown sort mode %r (have: %s)"
                       % (mode, ", ".join(SORT_MODES)))
    return (v is None, v if v is not None else 0, name)


def sort_preset_entries(entries, mode):
    """Entries sorted for the picker; see preset_sort_key."""
    return sorted(entries, key=lambda e: preset_sort_key(e, mode))


def center_scroll(total, sel, vis):
    """Top index of a vis-row window over total rows that keeps sel
    vertically centered (vim scrolloff-to-center): the cursor sits mid-
    viewport while scrolling and only approaches the top/bottom edge near
    the ends of the list. Pure function (unit-tested)."""
    if vis <= 0 or total <= vis:
        return 0
    return max(0, min(sel - (vis - 1) // 2, total - vis))


def characterful_overrides(preset_params, spec_map, defaults, exclude=(),
                           limit=6):
    """The preset's most characterful overrides: params that differ from
    their defaults, ranked by how far they sit from the default relative
    to the knob's range (enum/bool changes score 0.5). Headline keys in
    `exclude` and the system group are skipped. Returns up to `limit`
    (key, normalized value) pairs, deterministic order."""
    scored = []
    for key, raw in (preset_params or {}).items():
        if key in exclude or key not in spec_map:
            continue
        spec = spec_map[key]
        if spec.get("group") == "system":
            continue
        try:
            v = normalize_value(key, spec, raw)
        except ParamError:
            continue
        d = defaults.get(key)
        if v == d:
            continue
        if spec.get("type") in ("float", "int"):
            lo = float(spec.get("min", 0))
            hi = float(spec.get("max", 1))
            span = hi - lo
            score = abs(float(v) - float(d if d is not None else lo)) / span \
                if span > 0 else 0.0
        else:
            score = 0.5
        scored.append((score, key, v))
    scored.sort(key=lambda s: (-s[0], s[1]))
    return [(key, v) for _score, key, v in scored[:limit]]


def preset_detail_lines(entry, spec_map, defaults, width, utf=True):
    """Details-pane content for one picker entry: name, meta summary,
    word-wrapped description, headline settings (phosphor / mask / raster
    lines / geometry / era, plus a terminal font-size override when the
    preset carries one), then the most characterful overrides. Pure
    function (unit-tested); returns a list of strings at most `width`
    columns wide. Tolerates entries without meta."""
    if width < 1:
        return []
    sep = " · " if utf else " | "
    lines = [(entry.get("name") or "")[:width]]
    meta = entry.get("meta") or {}
    bits = []
    if meta.get("manufacturer"):
        bits.append(str(meta["manufacturer"]))
    if meta.get("year"):
        bits.append(str(meta["year"]))
    if meta.get("type"):
        bits.append(str(meta["type"]))
    if meta.get("price_usd") is not None:
        bits.append("$%g" % meta["price_usd"])
    if bits:
        lines.extend(wrap_text(sep.join(bits), width))
    desc = entry.get("description") or ""
    if desc:
        lines.append("")
        lines.extend(wrap_text(desc, width))
    params = entry.get("params") or {}
    rows = []
    for key in DETAIL_KEYS:
        spec = spec_map.get(key)
        if spec is None:
            continue
        raw = params.get(key, defaults.get(key))
        try:
            val = display_value(spec, normalize_value(key, spec, raw))
        except ParamError:
            val = str(raw)
        if spec.get("unit"):
            val += " " + spec["unit"]
        rows.append((spec.get("label", key.upper()), val))
    term = entry.get("terminal") or {}
    if isinstance(term, dict) and term.get("font-size") is not None:
        rows.append(("FONT SIZE",
                     format_terminal_value(term["font-size"]) + " (terminal)"))
    extras = characterful_overrides(params, spec_map, defaults,
                                    exclude=DETAIL_KEYS)
    extra_rows = []
    for key, v in extras:
        spec = spec_map[key]
        val = display_value(spec, v)
        if spec.get("unit"):
            val += " " + spec["unit"]
        extra_rows.append((spec.get("label", key), val))
    labw = min(16, max((len(l) for l, _v in rows + extra_rows), default=0))
    if rows:
        lines.append("")
        for label, val in rows:
            lines.append(("%-*s %s" % (labw, label[:labw], val))[:width])
    if extra_rows:
        lines.append("")
        bar = "─" if utf else "-"
        lines.append((bar + " character " + bar * max(0, width - 13))[:width])
        for label, val in extra_rows:
            lines.append(("%-*s %s" % (labw, label[:labw], val))[:width])
    return lines


# --------------------------------------------------------------------------
# files
# --------------------------------------------------------------------------

def atomic_write(path, data):
    """Write data to path atomically (tmp file in same dir + os.replace).
    On any failure the destination is left untouched and the tmp is removed."""
    d = os.path.dirname(os.path.abspath(path)) or "."
    fd, tmp = tempfile.mkstemp(prefix=os.path.basename(path) + ".", suffix=".tmp", dir=d)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        # mkstemp creates 0600; give the final file normal umask permissions
        umask = os.umask(0)
        os.umask(umask)
        os.chmod(tmp, 0o666 & ~umask)
        _REPLACE(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def inject_defines(template_text, block_lines):
    """Replace every line whose stripped content is exactly //@CRT_PARAMS@ with
    the define block. Everything else is passed through byte-identical."""
    out = []
    hit = False
    for line in template_text.splitlines(keepends=True):
        if line.strip() == MARKER:
            hit = True
            nl = "\r\n" if line.endswith("\r\n") else "\n"
            out.append(nl.join(block_lines) + nl)
        else:
            out.append(line)
    if not hit:
        raise CrtError("template has no marker line %r" % MARKER)
    return "".join(out)


# --------------------------------------------------------------------------
# reload transport (subprocess argv; runner is injectable for tests):
# D-Bus via gdbus on Linux, SIGUSR2 via pkill on macOS, or a custom
# command from $GHOSTTY_CRT_RELOAD_CMD on any platform.
# --------------------------------------------------------------------------

def object_path_for(dest):
    """GTK exports org.gtk.Actions at the object path derived from the
    application ID (dots -> slashes): com.mitchellh.ghostty ->
    /com/mitchellh/ghostty, io.arf.ghostty_phosphor ->
    /io/arf/ghostty_phosphor."""
    return "/" + dest.replace(".", "/")


def build_reload_argv(dest):
    return [
        "gdbus", "call", "--session",
        "--dest", dest,
        "--object-path", object_path_for(dest),
        "--method", "org.gtk.Actions.Activate",
        "reload-config", "[]", "{}",
    ]


def build_listnames_argv():
    return [
        "gdbus", "call", "--session",
        "--dest", "org.freedesktop.DBus",
        "--object-path", "/org/freedesktop/DBus",
        "--method", "org.freedesktop.DBus.ListNames",
    ]


def reload_argv(dest):
    """argv that asks the running CRT terminal to reload its config.
    $GHOSTTY_CRT_RELOAD_CMD (shell-style, shlex-split) overrides the
    transport outright; otherwise D-Bus on Linux, SIGUSR2 on macOS.
    Raises CrtError if the override is set but unparseable/empty."""
    custom = os.environ.get(RELOAD_CMD_ENV)
    if custom is not None:
        try:
            argv = shlex.split(custom)
        except ValueError as e:
            raise CrtError("%s: %s" % (RELOAD_CMD_ENV, e))
        if not argv:
            raise CrtError("%s is set but empty" % RELOAD_CMD_ENV)
        return argv
    if _PLATFORM == "darwin":
        return list(DARWIN_RELOAD_ARGV)
    return build_reload_argv(dest)


def default_runner(argv, timeout=5.0):
    """Run argv, return (returncode, stdout, stderr). Never raises on nonzero."""
    proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    return proc.returncode, proc.stdout, proc.stderr


# --------------------------------------------------------------------------
# controller
# --------------------------------------------------------------------------

class CrtCtl:
    """Model layer: params.json + state.json + generation + reload + presets."""

    def __init__(self, base=None, runner=None, on_warn=None):
        self.base = os.path.abspath(base or default_base())
        self.crt_dir = os.path.join(self.base, "crt")
        self.params_path = os.path.join(self.crt_dir, "params.json")
        self.state_path = os.path.join(self.crt_dir, "state.json")
        self.templates_dir = os.path.join(self.crt_dir, "templates")
        self.presets_dir = os.path.join(self.crt_dir, "presets")
        self.profiles_dir = os.path.join(self.crt_dir, "profiles")
        self.shaders_dir = os.path.join(self.base, "shaders")
        self.overrides_path = os.path.join(self.base, OVERRIDES_NAME)
        self.runner = runner or default_runner
        self.warnings = []
        self.on_warn = on_warn  # optional sink (TUI); default prints to stderr
        self.active_preset = None
        self.last_generated = None
        self._load_params()
        self._load_state()

    # -- warnings ----------------------------------------------------------

    def warn(self, msg):
        self.warnings.append(msg)
        if self.on_warn is not None:
            self.on_warn(msg)
        else:
            print("crtctl: warning: %s" % msg, file=sys.stderr)

    # -- loading -----------------------------------------------------------

    def _load_params(self):
        try:
            with open(self.params_path, encoding="utf-8") as f:
                doc = json.load(f)
        except FileNotFoundError:
            raise CrtError("params.json not found at %s "
                           "(set GHOSTTY_CRT_HOME?)" % self.params_path)
        except json.JSONDecodeError as e:
            raise CrtError("params.json is invalid JSON: %s" % e)
        params = doc.get("params")
        if not isinstance(params, dict) or not params:
            raise CrtError("params.json has no 'params' map")
        self.groups = doc.get("groups") or {}
        self.params = params
        self.defaults = {}
        for key, spec in params.items():
            if "define" not in spec or "type" not in spec:
                raise CrtError("params.json: %s is missing 'define' or 'type'" % key)
            self.defaults[key] = normalize_value(key, spec, spec.get("default"))

    def _load_state(self):
        self.values = dict(self.defaults)
        self.terminal = {}
        self.active_preset = None
        self.last_generated = None
        self.swap_style = "carry"
        if not os.path.isfile(self.state_path):
            return
        try:
            with open(self.state_path, encoding="utf-8") as f:
                st = json.load(f)
        except (OSError, json.JSONDecodeError) as e:
            self.warn("state.json unreadable (%s); using defaults" % e)
            return
        for key, raw in (st.get("values") or {}).items():
            if key not in self.params:
                self.warn("state.json: unknown param %r dropped" % key)
                continue
            try:
                # soft: an out-of-nominal value the user committed survives
                # the round trip; only hard bounds (or garbage) fall back.
                self.values[key] = normalize_value(key, self.params[key], raw,
                                                   soft=True)
            except ParamError as e:
                self.warn("state.json: %s; using default" % e)
        self.terminal = self._terminal_from_doc(st, "state.json")
        self.active_preset = st.get("active_preset")
        self.last_generated = st.get("last_generated")
        style = st.get("swap_style", "carry")
        self.swap_style = style if style in SWAP_STYLES else "carry"

    def save_state(self):
        overrides = {k: v for k, v in self.values.items() if v != self.defaults[k]}
        doc = {
            "version": 1,
            "active_preset": self.active_preset,
            "values": overrides,
            "last_generated": self.last_generated,
            "swap_style": getattr(self, "swap_style", "carry"),
        }
        if self.terminal:
            doc["terminal"] = dict(self.terminal)
        os.makedirs(self.crt_dir, exist_ok=True)
        atomic_write(self.state_path, json.dumps(doc, indent=2) + "\n")

    # -- get/set -----------------------------------------------------------

    def _spec(self, key):
        if key not in self.params:
            raise ParamError("unknown parameter %r (see 'crtctl list')" % key)
        return self.params[key]

    def get(self, key):
        self._spec(key)
        return self.values[key]

    def set(self, key, raw, soft=True):
        """Set one value and return the canonical form.

        soft=True (default): the nominal [min, max] is a band, not a wall.
        An out-of-nominal value is accepted, quantized, and reported once
        through warn() as
            <key> = <v> is outside the nominal range <lo>..<hi>: <consequence>
        where <consequence> is the schema's range_note (or a generic
        sentence). A value beyond a hard bound raises ParamError naming the
        bound and its hard_why — nothing is changed.
        soft=False: dial semantics — clamp to [min, max], never warn. Use
        this for knob-style callers that expect to stop at the end of the
        travel (typed entry is what goes past it)."""
        spec = self._spec(key)
        v = normalize_value(key, spec, raw, soft=soft)
        self.values[key] = v
        if soft:
            status, lo, hi = range_status(spec, v)
            if status != "ok":
                self.warn("%s = %s is outside the nominal range %s..%s: %s"
                          % (key, display_value(spec, v), _num_text(lo),
                             _num_text(hi), nominal_note(spec, v)))
        return v

    def range_status(self, key):
        """('ok' | 'over' | 'under', lo, hi) for the current value of key
        against its nominal range (see module-level range_status)."""
        return range_status(self._spec(key), self.values[key])

    # -- terminal overrides --------------------------------------------------

    def _terminal_from_doc(self, doc, origin):
        """Validated copy of doc['terminal'] (whitelist enforced). Invalid
        entries warn and drop — a bad file must not brick loading."""
        term = doc.get("terminal")
        out = {}
        if isinstance(term, dict):
            for k, v in term.items():
                try:
                    out[k] = normalize_terminal(k, v)
                except ParamError as e:
                    self.warn("%s: %s; entry dropped" % (origin, e))
        elif term is not None:
            self.warn("%s: 'terminal' must be an object; ignored" % origin)
        return out

    def set_terminal(self, key, raw):
        """Set one whitelisted terminal override. Raises ParamError on an
        unknown key or invalid/out-of-range value."""
        v = normalize_terminal(key, raw)
        self.terminal[key] = v
        return v

    def unset_terminal(self, key):
        """Remove one override. Returns True if it was set."""
        if key not in TERMINAL_KEYS:
            raise ParamError("terminal: unknown key %r (allowed: %s)"
                             % (key, ", ".join(TERMINAL_KEYS)))
        return self.terminal.pop(key, None) is not None

    def write_overrides(self):
        """Write <base>/crt-overrides.conf atomically (empty when no
        overrides). The launcher passes this file as --config-file, so a
        Ghostty reload picks the values up."""
        os.makedirs(self.base, exist_ok=True)
        atomic_write(self.overrides_path, overrides_text(self.terminal))
        return self.overrides_path

    # -- generation --------------------------------------------------------

    def define_block(self):
        lines = [GUARD_DEFINE]
        for key, spec in self.params.items():
            lines.append("#define %s %s" % (spec["define"],
                                            define_value(spec, self.values[key])))
        return lines

    def template_files(self):
        if not os.path.isdir(self.templates_dir):
            return []
        return sorted(
            os.path.join(self.templates_dir, n)
            for n in os.listdir(self.templates_dir)
            if n.endswith(TEMPLATE_SUFFIX)
        )

    def generate(self):
        """Render every template into shaders/. Returns list of output paths.
        Also rewrites crt-overrides.conf so terminal overrides always ride
        along with a generate + reload cycle."""
        block = self.define_block()
        self.write_overrides()
        templates = self.template_files()
        if not templates:
            self.warn("no templates in %s; nothing generated" % self.templates_dir)
            return []
        os.makedirs(self.shaders_dir, exist_ok=True)
        outs = []
        for tpl in templates:
            name = os.path.basename(tpl)[: -len(TEMPLATE_SUFFIX)] + ".glsl"
            out = os.path.join(self.shaders_dir, name)
            with open(tpl, encoding="utf-8", newline="") as f:
                text = f.read()
            try:
                rendered = inject_defines(text, block)
            except CrtError as e:
                raise CrtError("%s: %s" % (os.path.basename(tpl), e))
            atomic_write(out, rendered)
            outs.append(out)
        self.last_generated = time.strftime("%Y-%m-%dT%H:%M:%S")
        return outs

    # -- reload ------------------------------------------------------------

    def reload(self, dest=DEFAULT_DEST):
        """Ask the running Ghostty to reload its config (rereads shaders).
        Transport per reload_argv(). Returns (ok, detail); never raises."""
        try:
            argv = reload_argv(dest)
        except CrtError as e:
            self.warn(str(e))
            return False, str(e)
        # In the failure messages, name what we actually called: the D-Bus
        # dest on Linux, the literal command for signal/custom transports.
        label = dest if argv[:1] == ["gdbus"] else " ".join(argv)
        try:
            rc, out, err = self.runner(argv)
        except FileNotFoundError:
            self.warn("%s not found on PATH; reload skipped" % argv[0])
            return False, "%s not found" % argv[0]
        except subprocess.TimeoutExpired:
            self.warn("%s timed out (target %s)" % (argv[0], label))
            return False, "timeout"
        except OSError as e:
            self.warn("%s failed: %s" % (argv[0], e))
            return False, str(e)
        if rc != 0:
            detail = (err or out or "").strip().splitlines()
            detail = detail[-1] if detail else ("exit %d" % rc)
            if "ServiceUnknown" in detail:
                detail = ("no instance owns %s — the CRT terminal is not "
                          "running. Launch it with: ghostty-phosphor-crt "
                          "(changes only show in that window; stock Ghostty "
                          "does not load the CRT shaders)" % dest)
            elif os.path.basename(argv[0]) == "pkill" and rc == 1:
                detail = ("no process matches — the CRT terminal is not "
                          "running. Launch it with: ghostty-phosphor-crt-macos "
                          "(changes only show in that window; a plain "
                          "Ghostty does not load the CRT shaders)")
            self.warn("reload via %s failed: %s" % (label, detail))
            return False, detail
        return True, "ok"

    def list_bus_names(self):
        """All names on the session bus, or None if the query failed."""
        try:
            rc, out, err = self.runner(build_listnames_argv())
        except (OSError, subprocess.TimeoutExpired) as e:
            self.warn("could not list D-Bus names: %s" % e)
            return None
        if rc != 0:
            detail = (err or out or "").strip().splitlines()
            self.warn("could not list D-Bus names: %s"
                      % (detail[-1] if detail else "exit %d" % rc))
            return None
        return re.findall(r"'([^']*)'", out)

    def targets(self):
        """Reachable ghostty instances, or None on failure. Linux:
        session-bus names containing 'ghostty'. macOS: `pgrep -fl Ghostty`
        lines (pid + command), [] when none run — pgrep exits 1 for that."""
        if _PLATFORM == "darwin":
            try:
                rc, out, err = self.runner(list(DARWIN_TARGETS_ARGV))
            except FileNotFoundError:
                self.warn("pgrep not found on PATH")
                return None
            except (OSError, subprocess.TimeoutExpired) as e:
                self.warn("could not list Ghostty processes: %s" % e)
                return None
            if rc == 1:
                return []
            if rc != 0:
                detail = (err or out or "").strip().splitlines()
                self.warn("could not list Ghostty processes: %s"
                          % (detail[-1] if detail else "exit %d" % rc))
                return None
            return [l.strip() for l in out.splitlines() if l.strip()]
        names = self.list_bus_names()
        if names is None:
            return None
        return list(dict.fromkeys(n for n in names if "ghostty" in n.lower()))

    def dest_reachable(self, dest):
        """Would a reload reach something right now? True/False, or None
        when unknowable (probe failed, or a custom reload command is set —
        we cannot infer what it targets)."""
        if os.environ.get(RELOAD_CMD_ENV) is not None:
            return None
        if _PLATFORM == "darwin":
            found = self.targets()
            return None if found is None else bool(found)
        names = self.list_bus_names()
        return None if names is None else (dest in names)

    # -- presets -----------------------------------------------------------

    def list_presets(self):
        """[(name, description, path)] sorted by filename."""
        return [(e["name"], e["description"], e["path"])
                for e in self.list_preset_docs()]

    def list_preset_docs(self):
        """Full preset documents for the picker, sorted by filename:
        [{'name','description','meta','params','terminal','path'}].
        'meta' is None when the preset has no (dict) meta object — user
        saves and personal presets; the picker tolerates that everywhere."""
        if not os.path.isdir(self.presets_dir):
            return []
        out = []
        for fn in sorted(os.listdir(self.presets_dir)):
            if not fn.endswith(".json"):
                continue
            path = os.path.join(self.presets_dir, fn)
            try:
                with open(path, encoding="utf-8") as f:
                    doc = json.load(f)
            except (OSError, json.JSONDecodeError) as e:
                self.warn("preset %s unreadable: %s" % (fn, e))
                continue
            meta = doc.get("meta")
            term = doc.get("terminal")
            out.append({
                "name": doc.get("name") or fn[:-5],
                "description": doc.get("description") or "",
                "meta": meta if isinstance(meta, dict) else None,
                "params": doc.get("params") or {},
                "terminal": term if isinstance(term, dict) else {},
                "path": path,
            })
        return out

    def read_preset(self, name):
        path = os.path.join(self.presets_dir, name + ".json")
        if not os.path.isfile(path):
            for pname, _desc, ppath in self.list_presets():
                if pname == name:
                    path = ppath
                    break
            else:
                raise CrtError("preset %r not found in %s" % (name, self.presets_dir))
        try:
            with open(path, encoding="utf-8") as f:
                return json.load(f)
        except (OSError, json.JSONDecodeError) as e:
            raise CrtError("preset %r unreadable: %s" % (name, e))

    def _merge_over_defaults(self, overrides, origin):
        """Set self.values = defaults + overrides. Params in group 'system'
        (power state, sequence nonces) keep their current values unless the
        overrides name them explicitly — resetting a nonce would replay the
        power/degauss/erase sequences. Shared by preset and profile loading."""
        new = {}
        for key, spec in self.params.items():
            if spec.get("group") == "system" and key not in overrides:
                new[key] = self.values[key]
            else:
                new[key] = self.defaults[key]
        for key, raw in overrides.items():
            if key not in self.params:
                self.warn("%s: unknown param %r ignored" % (origin, key))
                continue
            try:
                # soft: presets and profiles carry out-of-nominal values
                # unchanged (the schema's caps are nominal, not walls);
                # only a hard bound or a malformed value falls back.
                new[key] = normalize_value(key, self.params[key], raw,
                                           soft=True)
            except ParamError as e:
                self.warn("%s: %s; using default" % (origin, e))
        self.values = new

    @staticmethod
    def _validate_name(name, what):
        name = (name or "").strip()
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name):
            raise CrtError("%s name must match [A-Za-z0-9][A-Za-z0-9._-]* "
                           "(got %r)" % (what, name))
        return name

    def apply_preset(self, name):
        """defaults + preset overrides (see _merge_over_defaults for the
        system-group rule). The preset's optional 'terminal' object REPLACES
        the current terminal overrides — a preset without one clears them.

        swap_style (state.json key, default 'carry') decides what happens
        to the previous tube's glow: 'carry' = persistence carries over
        and gets reinterpreted by the new phosphor (organic cross-preset
        ghosting — official behavior, not a bug); 'degauss' = same, plus
        the coil thunk; 'fresh' = new tube, instant clear (erase nonce)."""
        doc = self.read_preset(name)
        origin = "preset %r" % name
        self._merge_over_defaults(doc.get("params") or {}, origin)
        self.terminal = self._terminal_from_doc(doc, origin)
        self.active_preset = doc.get("name") or name
        style = getattr(self, "swap_style", "carry") or "carry"
        if style == "fresh" and "erase_nonce" in self.params:
            self._bump_nonce("erase_nonce")
        elif style == "degauss" and "degauss_nonce" in self.params:
            self._bump_nonce("degauss_nonce")

    def save_preset(self, name, description=""):
        """Save current non-default values (excluding group 'system')."""
        name = self._validate_name(name, "preset")
        params = {
            k: self.values[k]
            for k, spec in self.params.items()
            if spec.get("group") != "system" and self.values[k] != self.defaults[k]
        }
        doc = {"name": name, "description": description or "", "params": params}
        if self.terminal:
            doc["terminal"] = dict(self.terminal)
        os.makedirs(self.presets_dir, exist_ok=True)
        path = os.path.join(self.presets_dir, name + ".json")
        atomic_write(path, json.dumps(doc, indent=2) + "\n")
        self.active_preset = name
        return path

    def baseline_values(self):
        """defaults, plus the active preset's overrides if one is set."""
        base = dict(self.defaults)
        if self.active_preset:
            try:
                doc = self.read_preset(self.active_preset)
            except CrtError:
                return base
            for key, raw in (doc.get("params") or {}).items():
                if key in self.params:
                    try:
                        base[key] = normalize_value(key, self.params[key], raw,
                                                    soft=True)
                    except ParamError:
                        pass
        return base

    def modified_from_baseline(self):
        base = self.baseline_values()
        return any(
            self.values[k] != base[k]
            for k, spec in self.params.items()
            if spec.get("group") != "system"
        )

    # -- profiles (full-state snapshots, distinct from curated presets) ------

    def list_profiles(self):
        """[(name, saved, path)] sorted by filename."""
        if not os.path.isdir(self.profiles_dir):
            return []
        out = []
        for fn in sorted(os.listdir(self.profiles_dir)):
            if not fn.endswith(".json"):
                continue
            path = os.path.join(self.profiles_dir, fn)
            try:
                with open(path, encoding="utf-8") as f:
                    doc = json.load(f)
            except (OSError, json.JSONDecodeError) as e:
                self.warn("profile %s unreadable: %s" % (fn, e))
                continue
            out.append((doc.get("name") or fn[:-5], doc.get("saved") or "", path))
        return out

    def read_profile(self, name):
        path = os.path.join(self.profiles_dir, name + ".json")
        if not os.path.isfile(path):
            raise CrtError("profile %r not found in %s (see 'crtctl profiles')"
                           % (name, self.profiles_dir))
        try:
            with open(path, encoding="utf-8") as f:
                return json.load(f)
        except (OSError, json.JSONDecodeError) as e:
            raise CrtError("profile %r unreadable: %s" % (name, e))

    def save_profile(self, name):
        """Full-state snapshot: every non-default value (except the hidden
        system-group sequence nonces — restoring one would replay its
        power/degauss/erase animation), the active preset, and the terminal
        overrides. Overwrites an existing profile silently."""
        name = self._validate_name(name, "profile")
        params = {
            k: self.values[k]
            for k, spec in self.params.items()
            if self.values[k] != self.defaults[k]
            and not (spec.get("group") == "system" and spec.get("knob") == "hidden")
        }
        doc = {
            "name": name,
            "saved": time.strftime("%Y-%m-%dT%H:%M:%S"),
            "params": params,
            "active_preset": self.active_preset,
        }
        if self.terminal:
            doc["terminal"] = dict(self.terminal)
        os.makedirs(self.profiles_dir, exist_ok=True)
        path = os.path.join(self.profiles_dir, name + ".json")
        atomic_write(path, json.dumps(doc, indent=2) + "\n")
        return path

    def load_profile(self, name):
        """Restore exactly: defaults + stored values, active preset, terminal
        overrides (absent = cleared). System-group nonces follow the same
        preserve rule preset apply uses."""
        doc = self.read_profile(name)
        origin = "profile %r" % name
        self._merge_over_defaults(doc.get("params") or {}, origin)
        self.terminal = self._terminal_from_doc(doc, origin)
        self.active_preset = doc.get("active_preset")

    # -- special buttons ---------------------------------------------------

    def _bump_nonce(self, key):
        spec = self._spec(key)
        v = int(self.values[key]) + int(spec.get("step") or 1)
        hi = spec.get("max")
        if hi is not None and v > int(hi):
            v = int(spec.get("min") or 0)  # wrap instead of clamping dead
        self.values[key] = v
        return v

    def power(self, action="toggle"):
        """Returns (new_state, changed). Bumps power_nonce when state changes."""
        if "power_on" not in self.params:
            raise CrtError("params.json defines no 'power_on'")
        cur = bool(self.values["power_on"])
        if action == "toggle":
            target = not cur
        elif action == "on":
            target = True
        elif action == "off":
            target = False
        else:
            raise ParamError("power: expected on|off|toggle, got %r" % action)
        changed = target != cur
        if changed:
            self.values["power_on"] = target
            if "power_nonce" in self.params:
                self._bump_nonce("power_nonce")
        return target, changed

    def degauss(self):
        """Returns the new degauss_nonce."""
        if "degauss_nonce" not in self.params:
            raise CrtError("params.json defines no 'degauss_nonce'")
        return self._bump_nonce("degauss_nonce")

    def erase(self):
        """Returns the new erase_nonce (DVST storage-tube page erase)."""
        if "erase_nonce" not in self.params:
            raise CrtError("params.json defines no 'erase_nonce'")
        return self._bump_nonce("erase_nonce")


