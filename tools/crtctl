#!/usr/bin/env python3
# crtctl — hidden analog control surface for the Ghostty CRT shader simulation.
#
# Usage:
#   crtctl                          launch MONOSCOPE, the control surface (default on a tty)
#   crtctl panel [--motion M] [--no-splash] [--no-mouse] [--fps N] [--flat-field]
#   crtctl get <param>              print one value
#   crtctl set <param> <value>     set (validate+quantize; values outside the
#                                   nominal min..max are accepted with a
#                                   stderr warning naming the consequence;
#                                   only a schema hard_min/hard_max refuses),
#                                   regenerate, reload
#   crtctl list [group]             list values + ranges, grouped ("⚠ outside
#                                   nominal" marks values past the band)
#   crtctl apply                    regenerate shaders from current state and reload
#   crtctl preset <name>            apply preset (defaults + overrides), regen, reload
#   crtctl preset --save <name> --description "..."    save current non-defaults
#   crtctl presets                  list presets with descriptions (active marked *)
#   crtctl save <name>              save a full-state profile snapshot (alias: --save)
#   crtctl load <name>              restore a profile, regen, reload (alias: --load)
#   crtctl profiles                 list saved profiles with timestamps
#   crtctl terminal [key [value]]   terminal overrides: font-size (6..40) or
#                                   font-family; value 'default' clears one;
#                                   no args shows the current overrides
#   crtctl power [on|off|toggle]    tube power (bumps power_nonce), regen, reload
#   crtctl degauss                  fire the degauss coil (bumps degauss_nonce)
#   crtctl erase                    fire the DVST page erase (bumps erase_nonce)
#   crtctl targets                  list reachable ghostty instances
#   crtctl status                   paths, active preset, dest reachability, last gen
#
# Options:
#   --dest NAME    D-Bus destination for reload (default io.arf.ghostty_phosphor; env GHOSTTY_CRT_DEST overrides)
#   --save NAME    alias for 'crtctl save NAME'
#   --load NAME    alias for 'crtctl load NAME'
#
# Reload transport: on Linux the reload is a D-Bus org.gtk.Actions call to
# --dest; on macOS it is `pkill -USR2 -f Ghostty` (Ghostty's AppKit runtime
# installs a SIGUSR2 -> reload_config handler at launch). Setting
# GHOSTTY_CRT_RELOAD_CMD (a shell-style command line) replaces the transport
# on any platform, e.g. GHOSTTY_CRT_RELOAD_CMD='pkill -USR2 -x ghostty'.
#
# Files (base dir = $GHOSTTY_CRT_HOME if set, else $XDG_CONFIG_HOME/ghostty
# if set, else ~/.config/ghostty; on macOS the fallback is
# ~/Library/Application Support/com.mitchellh.ghostty — Ghostty reads config
# from both places there, see src/config/Config.zig loadDefaultFiles):
#   crt/params.json              parameter definitions — the single source of truth
#   crt/state.json               current values (non-default) + active preset name
#                                + terminal overrides
#   crt/templates/*.glsl.tmpl    shader templates containing a //@CRT_PARAMS@ line
#   crt/presets/*.json           presets: {"name","description","params":{...}}
#                                (optional "terminal":{...} — replaces on apply;
#                                optional "meta":{year,type,manufacturer,
#                                price_usd,resolution} — drives the TUI preset
#                                picker's details pane and sort modes)
#   crt/profiles/*.json          full-state profiles: {"name","saved","params",
#                                "active_preset","terminal"}
#   crt-overrides.conf           terminal overrides (one 'key = value' per line),
#                                passed to the fork via --config-file at launch
#   shaders/                     generated GLSL output (one file per template)
#
# The panel: `crtctl` (no verb, on a tty) or `crtctl panel` launches MONOSCOPE,
# the demoscene control surface in tools/monoscope/ (stdlib only, its own
# truecolor renderer — no curses, no palette hacks, no optional skins). The
# CLI verbs below never import it; the panel is `crtctl`'s interactive form.
# Options: --motion full|reduced|off, --no-splash, --no-mouse, --fps N,
# --flat-field (see tools/monoscope/README.md).
#
# Every parameter renders dynamically from params.json; nothing is hardcoded here.
# Python 3 stdlib only. Full manual: tools/README.md next to this script.

