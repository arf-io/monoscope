def _apply_pipeline(ctl, dest, verbose=True):
    """generate + save_state + reload. Returns exit code (0 ok, 2 reload fail)."""
    outs = ctl.generate()
    ctl.save_state()
    if verbose:
        for o in outs:
            print("generated %s" % o)
    ok, detail = ctl.reload(dest)
    if verbose:
        print("reload %s: %s" % (dest, "ok" if ok else "FAILED (%s)" % detail))
    return 0 if ok else 2


def _range_text(spec, value=None):
    """Nominal range text for list/help. With a value, a trailing
    ' ⚠ outside nominal' (ASCII: ' ! outside nominal') marks a value that
    sits outside the nominal band."""
    t = spec.get("type")
    if t == "enum":
        return "(%s)" % "|".join(spec.get("values") or {})
    if t == "bool":
        return "(on|off)"
    unit = spec.get("unit")
    r = "[%g .. %g step %g]" % (float(spec.get("min", 0)),
                                float(spec.get("max", 0)),
                                float(spec.get("step", 0) or 0))
    r += (" %s" % unit if unit else "")
    if value is not None and range_status(spec, value)[0] != "ok":
        r += outside_nominal_mark()
    return r


def cmd_get(ctl, args):
    print(display_value(ctl._spec(args.param), ctl.get(args.param)))
    return 0


def cmd_set(ctl, args, dest):
    v = ctl.set(args.param, args.value)
    print("%s = %s" % (args.param, display_value(ctl._spec(args.param), v)))
    return _apply_pipeline(ctl, dest, verbose=False)


def cmd_list(ctl, args):
    group_ids = list(ctl.groups)
    # groups referenced by params but missing from the groups map still list
    for spec in ctl.params.values():
        g = spec.get("group", "")
        if g not in group_ids:
            group_ids.append(g)
    if args.group:
        if args.group not in group_ids:
            raise CrtError("unknown group %r (have: %s)"
                           % (args.group, ", ".join(group_ids)))
        group_ids = [args.group]
    for gid in group_ids:
        keys = [k for k, s in ctl.params.items() if s.get("group") == gid]
        if not keys:
            continue
        print("[%s] %s" % (gid, ctl.groups.get(gid, "")))
        for k in keys:
            spec = ctl.params[k]
            val = display_value(spec, ctl.values[k])
            print("  %-18s %-14s %12s   %s"
                  % (k, spec.get("label", ""), val,
                     _range_text(spec, ctl.values[k])))
    return 0


def cmd_apply(ctl, dest):
    return _apply_pipeline(ctl, dest)


def cmd_preset(ctl, args, dest):
    if args.save:
        if not args.name:
            raise CrtError("preset --save requires a name")
        path = ctl.save_preset(args.name, args.description or "")
        ctl.save_state()
        print("saved preset %r -> %s" % (args.name, path))
        return 0
    if not args.name:
        raise CrtError("usage: crtctl preset <name>  |  crtctl preset --save <name>")
    ctl.apply_preset(args.name)
    print("applied preset %r" % ctl.active_preset)
    return _apply_pipeline(ctl, dest)


def cmd_presets(ctl):
    presets = ctl.list_presets()
    if not presets:
        print("(no presets in %s)" % ctl.presets_dir)
        return 0
    for name, desc, _path in presets:
        mark = "*" if name == ctl.active_preset else " "
        print("%s %-20s %s" % (mark, name, desc))
    return 0


def cmd_power(ctl, args, dest):
    state, changed = ctl.power(args.action)
    print("power %s%s" % ("on" if state else "off",
                          "" if changed else " (unchanged)"))
    if not changed:
        return 0
    return _apply_pipeline(ctl, dest, verbose=False)


def cmd_degauss(ctl, dest):
    nonce = ctl.degauss()
    print("degauss fired (nonce %d)" % nonce)
    return _apply_pipeline(ctl, dest, verbose=False)


def cmd_erase(ctl, dest):
    nonce = ctl.erase()
    print("erase fired (nonce %d)" % nonce)
    return _apply_pipeline(ctl, dest, verbose=False)


def cmd_save(ctl, args):
    path = ctl.save_profile(args.name)
    print("saved profile %r -> %s" % (args.name, path))
    return 0


def cmd_load(ctl, args, dest):
    ctl.load_profile(args.name)
    print("loaded profile %r" % args.name)
    return _apply_pipeline(ctl, dest)


def cmd_profiles(ctl):
    profiles = ctl.list_profiles()
    if not profiles:
        print("(no profiles in %s)" % ctl.profiles_dir)
        return 0
    for name, saved, _path in profiles:
        print("%-20s saved %s" % (name, saved or "(unknown)"))
    return 0


def cmd_terminal(ctl, args, dest):
    if args.key is None:
        if not ctl.terminal:
            print("(no terminal overrides)")
        for k in sorted(ctl.terminal):
            print("%s = %s" % (k, format_terminal_value(ctl.terminal[k])))
        return 0
    if args.key not in TERMINAL_KEYS:
        raise ParamError("terminal: unknown key %r (allowed: %s)"
                         % (args.key, ", ".join(TERMINAL_KEYS)))
    if args.value is None:
        v = ctl.terminal.get(args.key)
        print(format_terminal_value(v) if v is not None else "(unset)")
        return 0
    if args.value == "default":
        was_set = ctl.unset_terminal(args.key)
        print("%s cleared%s" % (args.key, "" if was_set else " (was unset)"))
    else:
        v = ctl.set_terminal(args.key, args.value)
        print("%s = %s" % (args.key, format_terminal_value(v)))
    return _apply_pipeline(ctl, dest, verbose=False)


def cmd_targets(ctl):
    names = ctl.targets()
    if names is None:
        return 1
    if not names:
        print("(no ghostty processes)" if _PLATFORM == "darwin"
              else "(no ghostty names on the session bus)")
        return 0
    for n in names:
        print(n)
    return 0


def cmd_status(ctl, dest):
    print("base dir       %s" % ctl.base)
    print("params.json    %s (%d params, %d groups)"
          % (ctl.params_path, len(ctl.params), len(ctl.groups)))
    print("state.json     %s%s" % (ctl.state_path,
                                   "" if os.path.isfile(ctl.state_path)
                                   else " (missing; defaults)"))
    tpls = ctl.template_files()
    print("templates      %s (%d)" % (ctl.templates_dir, len(tpls)))
    print("shaders        %s" % ctl.shaders_dir)
    print("presets        %s (%d)" % (ctl.presets_dir, len(ctl.list_presets())))
    print("profiles       %s (%d)" % (ctl.profiles_dir, len(ctl.list_profiles())))
    term = ", ".join("%s=%s" % (k, format_terminal_value(v))
                     for k, v in sorted(ctl.terminal.items()))
    print("term overrides %s -> %s" % (term or "(none)", ctl.overrides_path))
    preset = ctl.active_preset or "(defaults)"
    if ctl.modified_from_baseline():
        preset += " (modified)"
    print("active preset  %s" % preset)
    try:
        transport = " ".join(reload_argv(dest))
    except CrtError as e:
        transport = "(broken: %s)" % e
    print("reload via     %s" % transport)
    reachable = ctl.dest_reachable(dest)
    if reachable is None:
        reach = "unknown (probe failed or custom reload command)"
    elif reachable:
        reach = "reachable"
    elif _PLATFORM == "darwin":
        reach = "NOT running (no Ghostty process)"
    else:
        reach = "NOT on the session bus"
    print("dest           %s — %s" % (dest, reach))
    print("last generate  %s" % (ctl.last_generated or "(never)"))
    return 0


