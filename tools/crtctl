def wrap_text(text, width):
    """Greedy word-wrap. Returns a list of lines, each at most `width` chars;
    words longer than `width` are hard-broken. Pure function (unit-tested)."""
    if width < 1:
        return []
    lines = []
    cur = ""
    for word in (text or "").split():
        if cur and len(cur) + 1 + len(word) <= width:
            cur += " " + word
            continue
        if cur:
            lines.append(cur)
        while len(word) > width:
            lines.append(word[:width])
            word = word[width:]
        cur = word
    if cur:
        lines.append(cur)
    return lines


def run_panel(ctl, dest, opts=None):
    """Launch MONOSCOPE (tools/monoscope). Returns the process exit code:
    0 normally (reload failures show in the panel, never as exit codes),
    1 when the panel cannot run (no tty / package missing)."""
    tools_dir = os.path.dirname(os.path.realpath(__file__))   # realpath: ~/.local/bin/crtctl is a symlink
    if tools_dir not in sys.path:
        sys.path.insert(0, tools_dir)
    try:
        from monoscope.app import run_panel as _run
    except ImportError as e:
        print("crtctl: error: the MONOSCOPE panel is not installed beside this "
              "script (%s/monoscope): %s" % (tools_dir, e), file=sys.stderr)
        return 1
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("crtctl: error: the panel needs a terminal (stdin and stdout must be a tty)",
              file=sys.stderr)
        return 1
    import types
    core = types.SimpleNamespace(**globals())
    o = opts or argparse.Namespace()
    return _run(ctl, dest, core,
                motion=getattr(o, "motion", None),
                flat_field=bool(getattr(o, "flat_field", False)),
                mouse=not getattr(o, "no_mouse", False),
                ambient_fps=getattr(o, "fps", None),
                splash=not getattr(o, "no_splash", False))


