def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    # SUPPRESS: a subparser must not clobber a --dest given before the verb.
    common.add_argument("--dest", default=argparse.SUPPRESS,
                        help="D-Bus destination (default %s)" % DEFAULT_DEST)
    p = argparse.ArgumentParser(
        prog="crtctl",
        parents=[common],
        description="Control surface for the Ghostty CRT shader simulation.")
    # flag aliases for the profile verbs (crtctl --save night == crtctl save night)
    p.add_argument("--save", dest="save_profile", metavar="NAME", default=None,
                   help="alias for 'save NAME' (profile snapshot)")
    p.add_argument("--load", dest="load_profile", metavar="NAME", default=None,
                   help="alias for 'load NAME' (restore profile)")
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("get", parents=[common], help="print one value")
    sp.add_argument("param")
    sp = sub.add_parser("set", parents=[common],
                        help="set a value, regenerate, reload")
    sp.add_argument("param")
    sp.add_argument("value")
    sp = sub.add_parser("list", parents=[common], help="list values + ranges")
    sp.add_argument("group", nargs="?", default=None)
    sub.add_parser("apply", parents=[common],
                   help="regenerate shaders from state and reload")
    sp = sub.add_parser("preset", parents=[common], help="apply or save a preset")
    sp.add_argument("name", nargs="?", default=None)
    sp.add_argument("--save", action="store_true",
                    help="save current non-default values as <name>")
    sp.add_argument("--description", default="")
    sub.add_parser("presets", parents=[common], help="list presets")
    sp = sub.add_parser("save", parents=[common],
                        help="save a full-state profile snapshot")
    sp.add_argument("name")
    sp = sub.add_parser("load", parents=[common],
                        help="restore a profile, regenerate, reload")
    sp.add_argument("name")
    sub.add_parser("profiles", parents=[common],
                   help="list saved profiles with timestamps")
    sp = sub.add_parser("terminal", parents=[common],
                        help="terminal overrides (font-size, font-family)")
    sp.add_argument("key", nargs="?", default=None,
                    help="one of: %s" % ", ".join(TERMINAL_KEYS))
    sp.add_argument("value", nargs="?", default=None,
                    help="new value, or 'default' to clear the override")
    sp = sub.add_parser("power", parents=[common], help="tube power")
    sp.add_argument("action", nargs="?", default="toggle",
                    choices=["on", "off", "toggle"])
    sub.add_parser("degauss", parents=[common], help="fire the degauss coil")
    sub.add_parser("erase", parents=[common],
                   help="page erase: DVST flash / tube-swap clear elsewhere")
    sp = sub.add_parser("swap-style", parents=[common],
                        help="what preset switches do with the old tube's "
                             "glow: carry (ghosts, default) / degauss / fresh")
    sp.add_argument("style", nargs="?", default=None,
                    choices=["carry", "degauss", "fresh"])
    sub.add_parser("targets", parents=[common],
                   help="list reachable ghostty instances (D-Bus names on "
                        "Linux, processes on macOS)")
    sub.add_parser("status", parents=[common], help="show paths and state")
    sp = sub.add_parser("panel", parents=[common],
                        help="launch MONOSCOPE, the control surface (default on a tty)")
    sp.add_argument("--motion", choices=["full", "reduced", "off"], default=None,
                    help="animation: full (default), reduced, off")
    sp.add_argument("--no-splash", action="store_true", help="skip the logon splash")
    sp.add_argument("--no-mouse", action="store_true", help="keyboard only (M toggles live)")
    sp.add_argument("--fps", type=float, default=None, help="ambient frame rate (default 8)")
    sp.add_argument("--flat-field", action="store_true",
                    help="diagnostic: one flat colour on every cell (ghosts here are the shader's)")
    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    save_alias = getattr(args, "save_profile", None)
    load_alias = getattr(args, "load_profile", None)
    if save_alias or load_alias:
        if args.cmd is not None or (save_alias and load_alias):
            print("crtctl: error: --save/--load are standalone aliases "
                  "(use one, without a subcommand)", file=sys.stderr)
            return 1
        args.cmd = "save" if save_alias else "load"
        args.name = save_alias or load_alias
    if args.cmd is None:
        if sys.stdout.isatty():
            args.cmd = "panel"
        else:
            parser.print_help(sys.stderr)
            return 1
    dest = getattr(args, "dest", None) or DEFAULT_DEST
    try:
        ctl = CrtCtl()
        if args.cmd == "get":
            return cmd_get(ctl, args)
        if args.cmd == "set":
            return cmd_set(ctl, args, dest)
        if args.cmd == "list":
            return cmd_list(ctl, args)
        if args.cmd == "apply":
            return cmd_apply(ctl, dest)
        if args.cmd == "preset":
            return cmd_preset(ctl, args, dest)
        if args.cmd == "presets":
            return cmd_presets(ctl)
        if args.cmd == "power":
            return cmd_power(ctl, args, dest)
        if args.cmd == "degauss":
            return cmd_degauss(ctl, dest)
        if args.cmd == "erase":
            return cmd_erase(ctl, dest)
        if args.cmd == "swap-style":
            if args.style is None:
                print("swap-style = %s" % getattr(ctl, "swap_style", "carry"))
                return 0
            ctl.swap_style = args.style
            ctl.save_state()
            print("swap-style = %s (applies on the next preset switch)"
                  % args.style)
            return 0
        if args.cmd == "save":
            return cmd_save(ctl, args)
        if args.cmd == "load":
            return cmd_load(ctl, args, dest)
        if args.cmd == "profiles":
            return cmd_profiles(ctl)
        if args.cmd == "terminal":
            return cmd_terminal(ctl, args, dest)
        if args.cmd == "targets":
            return cmd_targets(ctl)
        if args.cmd == "status":
            return cmd_status(ctl, dest)
        if args.cmd == "panel":
            return run_panel(ctl, dest, args)
    except CrtError as e:
        print("crtctl: error: %s" % e, file=sys.stderr)
        return 1
    except OSError as e:
        print("crtctl: error: %s" % e, file=sys.stderr)
        return 1
    parser.print_help(sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
