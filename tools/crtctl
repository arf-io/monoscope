# value handling
# --------------------------------------------------------------------------

def default_base():
    """Directory holding crt/ + shaders/ + crt-overrides.conf. Resolution
    mirrors where Ghostty itself looks for config: $GHOSTTY_CRT_HOME wins,
    then $XDG_CONFIG_HOME/ghostty, then the platform default — on macOS
    ~/Library/Application Support/com.mitchellh.ghostty (Ghostty loads both
    the XDG and the App Support config there; src/config/Config.zig
    loadDefaultFiles), elsewhere ~/.config/ghostty."""
    env = os.environ.get("GHOSTTY_CRT_HOME")
    if env:
        return env
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        return os.path.join(xdg, "ghostty")
    if _PLATFORM == "darwin":
        return os.path.join(os.path.expanduser("~"), "Library",
                            "Application Support", "com.mitchellh.ghostty")
    return os.path.join(os.path.expanduser("~"), ".config", "ghostty")


def parse_bool(raw):
    if isinstance(raw, bool):
        return raw
    if isinstance(raw, (int, float)) and raw in (0, 1):
        return bool(raw)
    if isinstance(raw, str):
        s = raw.strip().lower()
        if s in ("1", "true", "on", "yes"):
            return True
        if s in ("0", "false", "off", "no"):
            return False
    raise ParamError("expected a boolean (on/off/true/false/1/0), got %r" % (raw,))


def quantize_float(v, spec, soft=False):
    """Snap v to the step grid anchored at min. soft=False (dial
    semantics) also clamps to the nominal [min, max]; soft=True keeps the
    value wherever it lands — the nominal range is a band, not a wall."""
    lo = spec.get("min")
    hi = spec.get("max")
    step = spec.get("step")
    if not soft:
        if lo is not None:
            v = max(v, float(lo))
        if hi is not None:
            v = min(v, float(hi))
    if step:
        base = float(lo) if lo is not None else 0.0
        v = base + round((v - base) / float(step)) * float(step)
        if not soft:
            if lo is not None:
                v = max(v, float(lo))
            if hi is not None:
                v = min(v, float(hi))
        v = round(v, 10)  # kill float fuzz from the multiply
    return float(v)


def quantize_int(v, spec, soft=False):
    """Integer twin of quantize_float: step grid anchored at min; clamps
    to [min, max] unless soft."""
    lo = spec.get("min")
    hi = spec.get("max")
    step = spec.get("step") or 1
    if not soft:
        if lo is not None:
            v = max(v, int(lo))
        if hi is not None:
            v = min(v, int(hi))
    base = int(lo) if lo is not None else 0
    v = base + int(round((v - base) / float(step))) * int(step)
    if not soft:
        if lo is not None:
            v = max(v, int(lo))
        if hi is not None:
            v = min(v, int(hi))
    return int(v)


def _num_text(x):
    """Compact human form of a schema number (int stays int; floats %.10g
    so 0.25, 6500 and 1100000 all read naturally)."""
    if isinstance(x, bool):
        return str(x)
    if isinstance(x, int):
        return str(x)
    return "%.10g" % float(x)


def hard_bounds(spec):
    """(hard_min, hard_max) of a spec — None where the schema declares
    none. A hard bound is a technical limit of the shader or generator
    (divide-by-zero, half-float texel ceiling, ...), never taste; the
    schema justifies each one in 'hard_why'."""
    return spec.get("hard_min"), spec.get("hard_max")


def _check_hard(key, spec, v, raw):
    """Raise ParamError naming the violated hard bound and its hard_why."""
    lo, hi = hard_bounds(spec)
    if lo is None and hi is None:
        return
    why = spec.get("hard_why") or "technical limit of the shader"
    shown = raw if isinstance(raw, str) else _num_text(raw)
    if lo is not None and v < lo:
        raise ParamError("%s: %s is below the hard minimum %s (%s)"
                         % (key, shown, _num_text(lo), why))
    if hi is not None and v > hi:
        raise ParamError("%s: %s is above the hard maximum %s (%s)"
                         % (key, shown, _num_text(hi), why))


def normalize_value(key, spec, raw, soft=False):
    """Coerce raw (from CLI/state/preset) to the canonical python value:
    float, int, bool, or enum member name (str), quantized to `step`
    (anchored at `min`).

    soft=False: dial semantics — clamp to the nominal [min, max]. This is
                what a knob does at the end of its travel.
    soft=True:  the nominal range is a band, not a wall. Values outside
                it are kept as given (quantized) — a preset carrying 2000
                scan lines is an experiment, not an error. Only the spec's
                hard_min/hard_max (where declared) are enforced, by
                raising ParamError that names the bound and its hard_why.

    On both paths a value that cannot be a GLSL literal of the param's
    type — an int outside 32 bits, a float past 3.4e38 — is refused:
    define_value would otherwise emit a define that glslang wraps, folds
    to inf, or rejects outright."""
    t = spec.get("type")
    if t == "float":
        try:
            v = float(raw)
        except (TypeError, ValueError):
            raise ParamError("%s: expected a number, got %r" % (key, raw))
        if not math.isfinite(v):
            raise ParamError("%s: value must be finite" % key)
        v = quantize_float(v, spec, soft=soft)
        if abs(v) > GLSL_FLOAT_MAX:
            raise ParamError("%s: %s does not fit a 32-bit GLSL float "
                             "(|value| must stay below 3.4e38; the shader "
                             "would compile it as inf)" % (key, _num_text(v)))
        _check_hard(key, spec, v, raw)
        return v
    if t == "int":
        try:
            v = int(round(float(raw)))
        except (TypeError, ValueError, OverflowError):
            raise ParamError("%s: expected an integer, got %r" % (key, raw))
        v = quantize_int(v, spec, soft=soft)
        if not (GLSL_INT_MIN <= v <= GLSL_INT_MAX):
            raise ParamError("%s: %d does not fit a 32-bit GLSL int "
                             "(%d..%d; the shader would wrap or reject the "
                             "literal)" % (key, v, GLSL_INT_MIN, GLSL_INT_MAX))
        _check_hard(key, spec, v, raw)
        return v
    if t == "bool":
        try:
            return parse_bool(raw)
        except ParamError:
            raise ParamError("%s: expected a boolean, got %r" % (key, raw))
    if t == "enum":
        values = spec.get("values") or {}
        if isinstance(raw, str) and raw in values:
            return raw
        # accept the integer code (or a numeric string) as well
        if not isinstance(raw, bool):
            try:
                code = int(str(raw).strip())
            except (TypeError, ValueError):
                code = None
            if code is not None:
                for name, num in values.items():
                    if num == code:
                        return name
        raise ParamError("%s: expected one of %s, got %r"
                         % (key, "|".join(values), raw))
    raise ParamError("%s: unknown type %r in params.json" % (key, t))


def format_float_glsl(v):
    """%.6g, but always containing '.' or an exponent so GLSL sees a float."""
    s = "%.6g" % float(v)
    if "." not in s and "e" not in s and "E" not in s:
        s += ".0"
    return s


def define_value(spec, value):
    """Value as it appears after '#define NAME '."""
    t = spec.get("type")
    if t == "float":
        return format_float_glsl(value)
    if t == "int":
        return str(int(value))
    if t == "bool":
        return "1" if value else "0"
    if t == "enum":
        return str(int((spec.get("values") or {})[value]))
    raise ParamError("unknown type %r" % t)


def display_value(spec, value):
    """Human/scriptable representation for get/list/TUI."""
    t = spec.get("type")
    if t == "float":
        return "%g" % value
    if t == "int":
        return str(int(value))
    if t == "bool":
        return "on" if value else "off"
    return str(value)  # enum member name


# --------------------------------------------------------------------------
# nominal range: min/max drive dial travel and the "normal" band, but a
# value may legitimately sit outside them (Appendix A of the UX proposal:
# "2000 scan lines is a legitimate experiment, not an error"). These helpers
# make that state legible instead of mysterious.
# --------------------------------------------------------------------------

def range_status(spec, value):
    """('ok' | 'over' | 'under', lo, hi): where value sits against the
    nominal [min, max]. Non-numeric specs (bool/enum) and specs without a
    range are always 'ok' with (None, None)."""
    if spec.get("type") not in ("float", "int"):
        return "ok", None, None
    lo = spec.get("min")
    hi = spec.get("max")
    if hi is not None and value > hi:
        return "over", lo, hi
    if lo is not None and value < lo:
        return "under", lo, hi
    return "ok", lo, hi


def nominal_note(spec, value):
    """The consequence sentence for value: '' inside the nominal range;
    otherwise spec['range_note'] (what the template math does past the
    band, written per param) or, where the schema has none, a generic
    sentence naming which side of the band the value lies on."""
    status, lo, hi = range_status(spec, value)
    if status == "ok":
        return ""
    note = spec.get("range_note")
    if note:
        return note
    if status == "over":
        return ("above the nominal maximum %s the shader applies the value "
                "literally; the look is uncalibrated there" % _num_text(hi))
    return ("below the nominal minimum %s the shader applies the value "
            "literally; the look is uncalibrated there" % _num_text(lo))


def outside_nominal_mark(stream=None):
    """The ' ⚠ outside nominal' marker, or its ASCII twin when the output
    stream cannot encode the glyph."""
    enc = getattr(stream if stream is not None else sys.stdout,
                  "encoding", None) or "ascii"
    try:
        OUTSIDE_NOMINAL_UTF.encode(enc)
    except (LookupError, UnicodeEncodeError):
        return OUTSIDE_NOMINAL_ASCII
    return OUTSIDE_NOMINAL_UTF


# --------------------------------------------------------------------------
# terminal overrides (font-size for low-res presets, etc.)
# --------------------------------------------------------------------------

def normalize_terminal(key, raw):
    """Validate one terminal-override entry against the whitelist.
    Returns the canonical value or raises ParamError. Out-of-range values
    are rejected, not clamped — a wrong font size should be loud."""
    if key == "font-size":
        if isinstance(raw, bool):
            raise ParamError("terminal font-size: expected a number, got %r" % (raw,))
        try:
            v = float(raw)
        except (TypeError, ValueError):
            raise ParamError("terminal font-size: expected a number, got %r" % (raw,))
        if not math.isfinite(v) or not (FONT_SIZE_MIN <= v <= FONT_SIZE_MAX):
            raise ParamError("terminal font-size: must be %g..%g, got %r"
                             % (FONT_SIZE_MIN, FONT_SIZE_MAX, raw))
        return int(v) if v.is_integer() else v
    if key == "font-family":
        if not isinstance(raw, str) or not raw.strip():
            raise ParamError("terminal font-family: expected a non-empty string, "
                             "got %r" % (raw,))
        s = raw.strip()
        if "\n" in s or "\r" in s:
            raise ParamError("terminal font-family: must be a single line")
        return s
    raise ParamError("terminal: unknown key %r (allowed: %s)"
                     % (key, ", ".join(TERMINAL_KEYS)))


def format_terminal_value(v):
    if isinstance(v, bool):
        return str(v)
    if isinstance(v, (int, float)):
        return "%g" % v
    return str(v)


def overrides_text(terminal):
    """Body of crt-overrides.conf: one 'key = value' line per entry (sorted
    for determinism), empty when there are no overrides."""
    return "".join("%s = %s\n" % (k, format_terminal_value(terminal[k]))
                   for k in sorted(terminal))


