#elif CRT_PHOSPHOR == 7
  const vec3 PH_TINT = vec3(0.874, 0.914, 1.000);   // P4 bluish white
#elif CRT_PHOSPHOR == 8
  const vec3 PH_TINT = vec3(1.000, 0.974, 0.916);   // paper white
#elif CRT_PHOSPHOR == 9
