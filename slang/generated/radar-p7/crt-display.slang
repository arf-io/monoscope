const vec3 LUMA = vec3(0.299, 0.587, 0.114);
const float PI = 3.14159265358979;

// Sequence pacing: thermal times scale with the WARMUP RATE knob; the
// fast electromagnetic events (collapse, line unfold) are near-real-time
// because they were fast in reality too.
#define WS (CRT_WARMUP_TIME_SCALE)

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// --------------------------------------------------------------------------
// State texture access
// --------------------------------------------------------------------------
vec4 stateAt(vec2 uv) {
    // Keep content sampling out of the data row (row 0).
    vec2 res = iResolution.xy;
    uv.y = max(uv.y, 2.5 / res.y);
    return _CRT_CH0(uv);
}

// --------------------------------------------------------------------------
// Power-on self-test overlay (DEC choreography; see params.json post_test).
// The POST phases replace the CONTENT the beam scans, so scanlines, mask,
// and glass all apply to them exactly as they did on the real terminals.
// Patterns are procedural suggestions of the documented screens (raw
// test-data mosaic, boxed OK, DECALN E-screen, VT340 crosshatch+circle).
// --------------------------------------------------------------------------
#if CRT_POST_TEST != 0

const vec2 POST_GRID = vec2(80.0, 24.0);

// The letter E, drawable at any cell resolution: left stem + three bars.
float postGlyphE(vec2 f) {
    // Antialiasing band for smooth text edges on sub-pixel boundaries
    float aaband = 0.02;
    float stem = smoothstep(0.12 - aaband, 0.12 + aaband, f.x)
               * smoothstep(0.30 + aaband, 0.30 - aaband, f.x);
    float bars = smoothstep(0.09 + aaband, 0.09 - aaband, abs(f.y - 0.82))
               + smoothstep(0.09 + aaband, 0.09 - aaband, abs(f.y - 0.50))
               + smoothstep(0.09 + aaband, 0.09 - aaband, abs(f.y - 0.18));
    float body = max(stem, min(bars, 1.0) * smoothstep(0.12 - aaband, 0.12 + aaband, f.x)
                                          * smoothstep(0.78 + aaband, 0.78 - aaband, f.x));
    return body * smoothstep(0.06 - aaband, 0.06 + aaband, f.y)
              * smoothstep(0.94 + aaband, 0.94 - aaband, f.y);
}

// Raw test data / uninitialized VRAM: dense random cells, ~15% reverse
// video, glyphs suggested by random sub-cell stripe patterns.
float postMosaic(vec2 cuv, float epoch) {
    vec2 cell = floor(cuv * POST_GRID);
    vec2 f = fract(cuv * POST_GRID);
    float r = hash12(cell + vec2(epoch * 13.7, epoch * 7.3));
    if (r > 0.85) return 0.95;                       // reverse-video block
    if (r < 0.06) return 0.0;                        // empty cell
    float row = floor(f.y * 6.0);
    float on = step(0.45, hash12(cell * 3.1 + vec2(row, epoch)));
    float aaband = 0.02;
    float inset = smoothstep(0.08 - aaband, 0.08 + aaband, f.x)
                * smoothstep(0.90 + aaband, 0.90 - aaband, f.x)
                * smoothstep(0.10 - aaband, 0.10 + aaband, f.y)
                * smoothstep(0.88 + aaband, 0.88 - aaband, f.y);
    return on * 0.75 * inset;
}

// "<terminal> OK" boxed at top-left: border rectangle + block text blobs.
float postOKBox(vec2 cuv) {
    vec2 c = cuv * POST_GRID;
    vec2 lo = vec2(2.0, POST_GRID.y - 3.5);
    vec2 hi = vec2(15.0, POST_GRID.y - 1.5);
    if (c.x < lo.x - 0.2 || c.x > hi.x + 0.2 ||
        c.y < lo.y - 0.2 || c.y > hi.y + 0.2) return 0.0;
    float aaband = 0.06;
    // Border: smooth fade on inner and outer edges (thickness ~0.12 horiz, 0.07 vert)
    float vBorder = smoothstep(0.12 + aaband, 0.12 - aaband, abs(c.x - lo.x))
                  + smoothstep(0.12 + aaband, 0.12 - aaband, abs(c.x - hi.x));
    float hBorder = smoothstep(0.07 + aaband, 0.07 - aaband, abs(c.y - lo.y))
                  + smoothstep(0.07 + aaband, 0.07 - aaband, abs(c.y - hi.y));
    float border = max(vBorder, hBorder) * 0.9;
    // Text row: blocky glyph suggestions centered in the box.
    float text = 0.0;
    if (c.y > lo.y + 0.7 && c.y < hi.y - 0.7 &&
        c.x > lo.x + 1.0 && c.x < hi.x - 1.0) {
        vec2 f = fract(vec2(c.x, (c.y - lo.y - 0.7) / 0.6));
        float col = floor(c.x);
        float body = step(0.42, hash12(vec2(col, floor(f.y * 3.0)) + 51.0));
        float aaband_text = 0.04;
        text = body * 0.85 * smoothstep(0.15 - aaband_text, 0.15 + aaband_text, f.x)
                          * smoothstep(0.85 + aaband_text, 0.85 - aaband_text, f.x);
    }
    return max(border, text);
}

// DECALN: the screen-alignment display — every cell an E.
float postEScreen(vec2 cuv) {
    return postGlyphE(fract(cuv * POST_GRID)) * 0.8;
}

// VT340 field-service crosshatch: line grid, corner blocks, center circle.
float postCrosshatch(vec2 cuv, float aspect) {
    vec2 g = cuv * vec2(10.0, 8.0);
    float aaband = 0.006;
    // Lines: smooth fade on both edges of the line
    float fxG = fract(g.x);
    float fyG = fract(g.y);
    float lines = max(smoothstep(aaband, -aaband, fxG) + smoothstep(1.0 - aaband, 1.0 + aaband, fxG),
                      smoothstep(aaband, -aaband, fyG) + smoothstep(1.0 - aaband, 1.0 + aaband, fyG)) * 0.5;
    vec2 d = (cuv - 0.5) * vec2(aspect, 1.0);
    float rr = length(d);
    float circle = smoothstep(0.006 + aaband, 0.006 - aaband, abs(rr - 0.38));
    vec2 corner = min(cuv, 1.0 - cuv);
    float blocks = smoothstep(0.06 + aaband, 0.06 - aaband, corner.x)
                 * smoothstep(0.08 + aaband, 0.08 - aaband, corner.y);
    return max(max(lines * 0.7, circle * 0.9), blocks * 0.85);
}

// Returns POST luminance at cuv for the current phase, or -1.0 when POST
// is not active (normal content shows).
float postLuma(vec2 cuv, float seq, float aspect) {
#if CRT_ERA == 0
    float tStart = 8.0 * WS + 3.75;
#elif CRT_ERA == 1
    float tStart = 6.0 * WS;
#else
    float tStart = 0.5;
#endif
    float t = seq - tStart;
    if (t < 0.0) return 0.0; // dark/warming: the test data runs unseen
#if CRT_POST_TEST == 1
    if (t < 0.8) return postMosaic(cuv, floor(t / 0.15));
    if (t < 1.0) return 0.0;
    if (t < 3.0) return postOKBox(cuv);
#else
    if (t < 1.5) return postMosaic(cuv, floor(t / 0.15));
    if (t < 1.7) return 0.0;
    if (t < 3.7) return postOKBox(cuv);
    if (t < 6.7) return postEScreen(cuv);
    if (t < 9.7) return postCrosshatch(cuv, aspect);
    if (t < 11.0) return 0.85; // white/full-raster fill (bias check)
#endif
    return -1.0;
}
#endif // CRT_POST_TEST

// --------------------------------------------------------------------------
// Power / warmup envelope
// --------------------------------------------------------------------------
struct PowerEnv {
    float hSpan;      // horizontal deflection span 0..1
    float vSpan;      // vertical deflection span 0..1
    float bright;     // luminance envelope (cathode emission, HV)
    float focusMul;   // spot-size multiplier (warmup defocus)
    float sizeMul;    // raster size settle (HV stabilization)
    float roll;       // vertical sync roll offset added during lock-in
    float skew;       // parallelogram error during sync settle
    float black;      // 1.0 = fully dark (heater cold / off complete)
};

PowerEnv powerEnvelope(float seq, float warm, float powerState, float nonce) {
    PowerEnv e;
    e.hSpan = 1.0; e.vSpan = 1.0; e.bright = 1.0; e.focusMul = 1.0;
    e.sizeMul = 1.0; e.roll = 0.0; e.skew = 0.0; e.black = 0.0;

    // Long-term thermal envelope (measured: sets settle over ~40 min,
    // here scaled): slight brightness rise then settle, focus tightens.
    float tSettle = max(warm / max(45.0 * WS * 6.67, 1.0), 0.0);
    float thermal = 1.0 - 0.25 * exp(-tSettle * 3.0);

    // Per-cycle jitter seed: each power event gets its own nonce (see the
    // P0 state machine), so consecutive power-ups/downs on the same tube
    // don't look identical — real heater/degauss timing varies cycle to
    // cycle. Bounded +/-15% so the choreography stays recognizable.
    float jitter = 0.85 + 0.30 * hash12(vec2(nonce, 11.7));

    if (powerState > 0.5) {
        // ------------------------------ POWER ON ------------------------
#if CRT_ERA == 0
        // 1960s tube set: HV exists before vertical deflection wakes.
        float tHeater = 8.0 * WS * jitter;      // heater glow -> first emission
        float tDot    = tHeater + 0.45 * jitter; // undeflected dot
        float tLine   = tDot + 0.7 * jitter;     // horizontal opens: thin scan line
        float tUnfold = tLine + 2.6 * jitter;    // vertical opens + sync locks
        if (seq < tHeater) {
            e.black = 1.0;
        } else if (seq < tDot) {
            float k = (seq - tHeater) / (tDot - tHeater);
            e.hSpan = 0.012; e.vSpan = 0.012;
            e.bright = 6.0 * k;            // energy of the whole raster in
            e.focusMul = 2.5;              // one spot (phosphor-saturated)
        } else if (seq < tLine) {
            float k = (seq - tDot) / (tLine - tDot);
            k = 1.0 - (1.0 - k) * (1.0 - k);   // magnetics ease out
            e.hSpan = mix(0.012, 1.0, k);
            // Real horizontal-only deflection collapse is a HAIRLINE, not
            // a thick bar: keep vSpan pinned at the beam-spot floor and
            // hold focus close to nominal (was 2.0, badly defocused —
            // that bloomed the line out to several scanlines wide).
            e.vSpan = 0.012;
            e.bright = mix(6.0, 3.5, k);   // line: ~height/spot energy gain
            e.focusMul = mix(1.4, 1.15, k);
        } else if (seq < tUnfold) {
            float k = (seq - tLine) / (tUnfold - tLine);
            k = 1.0 - pow(1.0 - k, 2.2);
            e.vSpan = mix(0.012, 1.0, k);
            e.bright = mix(3.5, 1.0, k);
            e.focusMul = mix(1.8, 1.15, k);
            // vertical hold hunts, slows, snaps in; parallelogram settles
            float lockK = 1.0 - k;
            e.roll = lockK * lockK * fract(seq * mix(4.0, 0.2, k));
            e.skew = 0.06 * lockK;
        } else {
            e.focusMul = mix(1.15, 1.0, min((seq - tUnfold) / (25.0 * WS * 6.67), 1.0));
        }
        e.bright *= mix(0.0, thermal, smoothstep(tHeater, tDot, seq));
#elif CRT_ERA == 1
        // 1980s solid state: flyback-derived HV — raster or nothing.
        // Degauss thunk at t=0, cathode fade-in, oversized raster settles.
        float tLight = 6.0 * WS;           // first light
        float tFade  = tLight + 3.5 * WS * 6.67;
        if (seq < tLight) {
            e.black = 1.0;
        } else {
            float k = smoothstep(tLight, tFade, seq);
            e.bright = k * thermal;
            e.focusMul = mix(1.6, 1.0, k);
            e.sizeMul = mix(1.018, 1.0, smoothstep(tLight, tFade + 8.0 * WS * 6.67, seq));
        }
#else
        // 1990s+: regulated supply, quick clean start.
        e.bright = smoothstep(0.05, 0.45, seq) * thermal;
        e.focusMul = mix(1.15, 1.0, smoothstep(0.05, 2.0, seq));
#endif
    } else {
        // ------------------------------ POWER OFF -----------------------
#if CRT_ERA == 2
        // Spot killer: G1 clamped hard negative, deflection outlives beam.
        e.bright = 1.0 - smoothstep(0.0, 0.12, seq);
        e.black = step(0.12, seq);
#else
        // Deflection collapses while stored EHT keeps the beam alive:
        // vertical dies first (bright line), then horizontal (dot), then
        // the dot bleeds away with the anode charge over seconds.
        float tLine = 0.20 * jitter;    // V collapse (yoke field decay)
        float tDot  = 0.55 * jitter;    // H collapse
        float tGone = 5.0 * jitter;     // charge bleed
        if (seq < tLine) {
            float k = seq / tLine;
            k = k * k;
            e.vSpan = mix(1.0, 0.010, k);
            // Energy concentration, clamped by phosphor saturation.
            e.bright = min(1.0 / max(e.vSpan, 0.02), 9.0) * 0.55;
            e.focusMul = 1.3;
        } else if (seq < tDot) {
            float k = (seq - tLine) / (tDot - tLine);
            k = k * k;
            e.vSpan = 0.010;
            e.hSpan = mix(1.0, 0.012, k);
            e.bright = min(9.0, mix(9.0, 14.0, k)) * 0.55;
            e.focusMul = 1.6;
        } else if (seq < tGone) {
            float k = (seq - tDot) / (tGone - tDot);
            e.vSpan = 0.010; e.hSpan = 0.012;
            e.bright = 14.0 * 0.55 * exp(-k * 5.5);
            e.focusMul = 1.9;
            e.roll = 0.004 * k;  // the dying dot sags slightly
        } else {
            e.black = 1.0;
        }
#endif
    }
    return e;
}

// --------------------------------------------------------------------------
// Deflection geometry: screen coord -> tube content coord.
// p is in [-1,1] centered screen space (pre-warp, aspect-true).
// --------------------------------------------------------------------------
vec2 warpToContent(vec2 p, PowerEnv env, float apl, float dgWobble) {
    // Raster rotation (yoke rotation).
    float rc = cos(CRT_ROTATION), rs = sin(CRT_ROTATION);
    p = mat2(rc, -rs, rs, rc) * p;

    // Parallelogram + trapezoid (yoke asymmetry), incl. sync-settle skew.
    p.x += (CRT_PARALLELOGRAM + env.skew) * p.y;
    p.x *= 1.0 + CRT_TRAPEZOID * p.y;

    // Faceplate curvature: inverse-map screen to tube. Quadratic warp
    // (Lottes form); cylindrical = horizontal-only (Trinitron: the
    // grille cannot curve vertically), spherical = both axes.
#if CRT_GEOM_MODE != 0
    float w = 1.0 / max(CRT_CURVE_RADIUS, 1.0);
    float wx = 0.18 * w;
    float wy = 0.24 * w;
  #if CRT_GEOM_MODE == 1
    p.x *= 1.0 + wx * p.y * p.y;   // cylindrical
  #else
    p *= vec2(1.0 + wx * p.y * p.y, 1.0 + wy * p.x * p.x); // spherical
  #endif
#endif

    // Pincushion residual (E-W correction misadjust): vertical-rate
    // parabola modulating width.
    p.x *= 1.0 + CRT_PINCUSHION * (p.y * p.y - 0.5) * 2.0;

    // HV breathing: bright scenes sag the EHT (~1kV/mA), raster grows as
    // 1/sqrt(V). Knob 0.25 ~= healthy 1.5% black->white.
    float breathe = 1.0 + CRT_HV_BREATHING * 0.06 * apl;

    // Degauss shimmy: the decaying AC field wobbles the whole raster.
    p.x += dgWobble * 0.006 * sin(iTime * 61.0);
    p.y += dgWobble * 0.004 * sin(iTime * 47.0 + 1.7);

    // Size / position / overscan / power-collapse spans.
    vec2 span = vec2(CRT_H_SIZE * env.hSpan, CRT_V_SIZE * env.vSpan);
    span *= breathe * env.sizeMul * (1.0 + CRT_OVERSCAN);
    p /= max(span, vec2(1e-4));
    p -= vec2(CRT_H_POS, CRT_V_POS) * 2.0;

    return p * 0.5 + 0.5; // -> content uv
}

// --------------------------------------------------------------------------
// Sync errors
// --------------------------------------------------------------------------
// Hold-in range of each sync loop: how far the oscillator can be detuned and
// still be dragged into step by the incoming sync pulses. Inside it the
// picture is stationary but carries a standing phase error; outside it the
// loop slips whole frames (or lines) and the picture moves.
//
// These are the sim's declared values, not measured ones -- hold-in depends
// on the set's discriminator and flywheel time constant, and varied widely.
// The vertical figure preserves the threshold this simulation has always
// used, so existing presets keep their feel; the horizontal one is chosen so
// that most of the knob's range still reaches the free-running tear the
// control is interesting for. See DESIGN.md's approximation ledger.
const float V_HOLD_HOLDIN = 0.15;    // Hz off field rate
const float H_HOLD_HOLDIN = 45.0;    // Hz off 15734 Hz line rate

// V-hold: out-of-lock vertical oscillator rolls the picture at the beat
// frequency (down if the oscillator runs fast, up if slow), hesitating
// near lock. Returns rolled y and the VBI-bar shade for that position.
float vHoldRoll(inout float y, float extraRoll) {
    float beat = CRT_V_HOLD;
    float phase = extraRoll;
    // A vertical hold circuit has three regimes, not two, and the boundary
    // between them is smooth. Detune normalized against the hold-in range:
    float u = beat / V_HOLD_HOLDIN;
    if (abs(u) <= 1.0) {
        // LOCKED, BUT PARKED. Inside hold-in the oscillator stays
        // synchronized, but only by running at a standing phase error
        // proportional to the detune. The picture does NOT move -- it sits
        // still, displaced, with the blanking bar parked across it. A TV
        // frozen half a screen out of place is this regime, and it is the
        // most common thing a misadjusted V-hold actually looks like.
        // Sawtooth phase discriminator, so hold-in runs to half a frame.
        phase += 0.5 * u;
    } else {
        // SLIPPING. Past hold-in the loop can no longer hold every field,
        // so it sheds whole frames. The slip rate leaves zero at the
        // boundary as sqrt(u^2 - 1) and only approaches the raw beat
        // frequency well outside it: the picture creeps, hesitates, tears
        // itself free, and settles again. It never steps from frozen to
        // full speed -- that discontinuity was the bug this replaces.
        float slip = V_HOLD_HOLDIN * sqrt(u * u - 1.0);
        float t = iTime * slip;
        // AFC hesitation: the ramp crawls as it approaches the sync pulse
        // each cycle, then snaps over.
        float crawl = t + 0.22 * sin(t * 2.0 * PI);
        // Carry the half-frame standing error across the boundary so the
        // picture's position is continuous through it, not just its speed.
        phase += sign(u) * (0.5 + fract(crawl));
    }
    if (phase == 0.0) return 1.0;
    y = fract(y - phase);
    // The blanking interval (~7.5% of the frame) rides the seam.
    float d = min(abs(y - 1.0), y); // distance to seam after wrap
    float bar = smoothstep(0.0, 0.075, d);
    return mix(0.05, 1.0, bar);
}

// H-hold: line oscillator offset shears successive lines into diagonal
// "venetian blind" tears with the black sync bar wrapping through.
float hHoldTear(inout float x, float y) {
    float df = CRT_H_HOLD;
    if (df == 0.0) return 1.0;
    // Same three regimes as the vertical hold, on the line oscillator.
    float u = df / H_HOLD_HOLDIN;
    float shift;
    float shear;
    if (abs(u) <= 1.0) {
        // LOCKED, BUT PARKED. Every line still starts on time relative to
        // its neighbours, so there is no shear -- the whole picture simply
        // sits sideways by the standing phase error, wrapping at the edge
        // with the sync bar showing. This is a horizontal hold set slightly
        // wrong: the image is displaced, not shredded.
        shift = 0.5 * u;
        shear = 0.0;
    } else {
        // SLIPPING. Past hold-in the line oscillator free-runs, so each
        // successive line starts a little later than the one above it and
        // the picture shears into the diagonal venetian blind. Both the
        // shear and the drift rate leave zero at the boundary, so the
        // tearing grows out of the displaced picture instead of appearing
        // all at once.
        float slip = H_HOLD_HOLDIN * sqrt(u * u - 1.0);
        shear = slip / 15734.0;
        shift = sign(u) * 0.5 + fract(iTime * slip * 0.02);
    }
    shift = fract(shift + y * float(CRT_SCAN_LINES) * shear);
    x = fract(x - shift);
    float d = min(abs(x - 1.0), x);
    float bar = smoothstep(0.0, 0.17 * min(abs(df) / 60.0, 1.0) + 0.001, d);
    return mix(0.06, 1.0, bar);
}

// --------------------------------------------------------------------------
// Content source indirection. All beam/glow sampling goes through
// contentAt() so that (a) the POST overlay replaces what the beam scans
// and (b) DECSCLM smooth scrolling glides the content through the fixed
// raster. Globals are set once in mainImage before sampling begins.
// --------------------------------------------------------------------------
int g_contentMode = 0;    // 0 = terminal content, 1 = POST pattern
float g_seq = 0.0;        // power-sequence clock (for POST phases)
float g_aspect = 1.33;
float g_shiftY = 0.0;     // smooth-scroll glide offset, uv units
float g_ilOffset = 0.0;   // spatial-interlace fallback offset, in lines

vec3 contentAt(vec2 uv) {
#if CRT_POST_TEST != 0
    if (g_contentMode == 1) {
        float l = max(postLuma(uv, g_seq, g_aspect), 0.0);
  #if CRT_MONO
        return vec3(l, 0.0, 0.0);
  #else
        return vec3(l);
  #endif
    }
#endif
    return stateAt(vec2(uv.x, uv.y - g_shiftY)).rgb;
}

// --------------------------------------------------------------------------
// Beam sampling: gaussian scanline profile with brightness-dependent spot
// growth (space charge), horizontal bandwidth softness, per-channel
// deconvergence folded into the tap weights (R/B land offset from G).
// --------------------------------------------------------------------------
vec3 scanSample(vec2 cuv, float focusMul, float cornerSoft) {
    vec2 res = iResolution.xy;
    float lines = float(CRT_SCAN_LINES);

    float srcY = cuv.y * lines - 0.5;
    // Interlace: when the temporal field engine is active the comb
    // structure is already in the excitation state and no offset is
    // wanted; otherwise the spatial half-line fallback (set in
    // mainImage from the measured refresh) alternates the grid.
    srcY += g_ilOffset;
    float y0 = floor(srcY);
    float fy = srcY - y0;

    // Horizontal bandwidth: video-amp softness in TVL across the width.
    float aspect = res.x / res.y;
    float sigmaX = res.x / (CRT_H_BANDWIDTH * aspect) * 0.45;
    sigmaX = max(sigmaX * focusMul * cornerSoft, 0.28);
    float pxU = 1.0 / res.x;

    // Deconvergence: static R/B landing error, worse toward corners.
    float convPx = CRT_MISCONVERGENCE * cornerSoft;
    float dR = -convPx * pxU;
    float dB =  convPx * pxU;

    vec3 acc = vec3(0.0);
    float wsum = 0.0;

    for (int line = 0; line < 2; line++) {
        float ly = y0 + float(line);
        float lineV = (ly + 0.5) / lines;
        // Smoothly fade scanlines at content edges instead of hard clipping.
        // This eliminates harsh cutoff at top/bottom and allows Gaussian beam
        // profile to taper naturally. Fade width ~2 pixels of content texture.
        float edgeFade = smoothstep(-0.04, 0.04, lineV) * smoothstep(1.04, 0.96, lineV);
        if (edgeFade < 0.001) continue;
        float dy = srcY - ly;

        // Peek line luminance to grow the spot (crt-geom physics:
        // sigma rises with brightness; energy-normalized below).
        vec3 peek = contentAt(vec2(cuv.x, lineV));
        float lum = clamp(dot(peek, LUMA), 0.0, 1.5);
        float sigma = CRT_SCAN_MIN_WIDTH
            * (1.0 + CRT_SCAN_BLOOM * 1.4 * pow(lum, 0.62))
            * focusMul * cornerSoft;

        // Gaussian beam profile in line units. The vertical weight is
        // deliberately NOT renormalized across lines: the profile IS the
        // raster (the gaps between beam passes are dark because no beam
        // went there). The 1/(sigma*sqrt(2pi)) factor conserves energy,
        // so blooming widens lines without brightening them and the
        // AVERAGE luminance stays calibrated. (Renormalizing across
        // both dimensions — the original bug — flattened all raster
        // structure on uniform content.)
        float wLine = exp(-0.5 * (dy / sigma) * (dy / sigma))
                    / (sigma * 2.5066283);

        // Horizontal taps are a filter and DO get normalized, per
        // channel (deconvergence shifts each channel's weights).
        vec3 lineAcc = vec3(0.0);
        vec3 lineW = vec3(1e-4);
        for (int i = -2; i <= 2; i++) {
            float dx = float(i);
            float wx = exp(-0.5 * (dx / sigmaX) * (dx / sigmaX));
            vec2 tuv = vec2(cuv.x + dx * pxU, lineV);
            vec3 s = contentAt(tuv);
            float wxR = exp(-0.5 * ((dx + convPx) / sigmaX) * ((dx + convPx) / sigmaX));
            float wxB = exp(-0.5 * ((dx - convPx) / sigmaX) * ((dx - convPx) / sigmaX));
            lineAcc += vec3(s.r * wxR, s.g * wx, s.b * wxB);
            lineW += vec3(wxR, wx, wxB);
        }
        acc += edgeFade * wLine * (lineAcc / lineW);
        wsum += edgeFade * wLine;
    }
    return acc / max(wsum, 1e-4);
}

// Vector/instrument tubes steer the beam directly in XY instead of through
// a fixed line raster. Sample the phosphor state with a round spot footprint
// so strokes stay continuous and do not inherit scanline combing.
vec3 vectorSample(vec2 cuv, float focusMul, float cornerSoft) {
    vec2 res = iResolution.xy;
    vec2 px = 1.0 / res;
    float sigmaPx = max(CRT_SCAN_MIN_WIDTH * 1.8 * focusMul * cornerSoft, 0.55);
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            vec2 d = vec2(float(x), float(y));
            float w = exp(-0.5 * dot(d, d) / (sigmaPx * sigmaPx));
            acc += contentAt(cuv + d * px) * w;
            wsum += w;
        }
    }
    return acc / max(wsum, 1e-4);
}

float linePulse(float d, float width) {
    return exp(-0.5 * (d / width) * (d / width));
}

float angleDelta(float a, float b) {
    return abs(atan(sin(a - b), cos(a - b)));
}

vec3 radarInstrumentLight(vec2 cuv, vec2 pFace) {
    if (CRT_RADAR_OVERLAY <= 0.0 && CRT_RADAR_SWEEP <= 0.0) return vec3(0.0);

    float aspect = iResolution.x / iResolution.y;
    vec2 p = vec2(pFace.x * aspect, pFace.y);
    float r = length(p);
    float a = atan(p.y, p.x);
    float edge = 1.0 - smoothstep(0.96, 1.02, r);

    float ring = 0.0;
    for (int i = 1; i <= 4; i++) {
        ring = max(ring, linePulse(abs(r - float(i) * 0.2), 0.0028));
    }
    float cross = max(linePulse(abs(p.x), 0.0022), linePulse(abs(p.y), 0.0022))
        * smoothstep(0.98, 0.86, r);
    float tick = 0.0;
    for (int i = 0; i < 12; i++) {
        float ta = -PI + float(i) * PI / 6.0;
        float ad = angleDelta(a, ta);
        float radial = smoothstep(0.98, 0.92, r) * smoothstep(0.78, 0.88, r);
        tick = max(tick, linePulse(ad * max(r, 0.1), 0.0035) * radial);
    }
    float center = linePulse(r, 0.018);
    float grid = clamp(ring * 0.55 + cross * 0.35 + tick * 0.8 + center * 0.35, 0.0, 1.0)
        * CRT_RADAR_OVERLAY * edge;

    float rpm = max(CRT_RADAR_SWEEP_RATE, 0.1);
    float sweepA = -0.5 * PI + iTime * rpm * (2.0 * PI / 60.0);
    float da = angleDelta(a, sweepA);
    float sweepLine = linePulse(da * max(r, 0.05), 0.010)
        * smoothstep(0.03, 0.10, r) * smoothstep(1.02, 0.92, r);
    float sweepBloom = exp(-da * 14.0) * smoothstep(0.03, 0.12, r)
        * smoothstep(1.0, 0.78, r) * 0.22;
    float sweep = (sweepLine + sweepBloom) * CRT_RADAR_SWEEP * edge;

#if CRT_PHOSPHOR == 9
    return vec3(grid * 0.55 + sweep * 1.7, grid * 0.35 + sweep * 0.45, 0.0);
#else
    return vec3(grid + sweep, grid * 0.75 + sweep * 0.4, grid * 0.25);
#endif
}

// --------------------------------------------------------------------------
// Deflection-collapse rendering (power on/off dot & line phases).
// When a deflection axis dies, ALL content along that axis lands on the
// same screen position: the bright line carries the vertical INTEGRAL of
// the picture (not a crop of its middle rows), and the dot carries the
// integral of everything. Energy concentration is already computed into
// env.bright (phosphor-saturation capped).
// --------------------------------------------------------------------------
vec3 collapseLine(float u) {
    // Vertical integral of the content at screen column u.
    vec3 acc = vec3(0.0);
    for (int i = 0; i < 12; i++) {
        acc += stateAt(vec2(u, (float(i) + 0.5) / 12.0)).rgb;
    }
    return acc / 12.0;
}

vec3 collapseAll() {
    // Full-screen integral (the dot's contents).
    vec3 acc = vec3(0.0);
    for (int y = 0; y < 4; y++)
        for (int x = 0; x < 4; x++)
            acc += stateAt((vec2(float(x), float(y)) + 0.5) / 4.0).rgb;
    return acc / 16.0;
}

// Returns emitted light for the collapse phases. pFace is the tube-face
// coordinate in [-1,1]; the feature sits at screen center regardless of
// content (the yoke is dead, not the picture).
vec3 collapseLight(vec2 pFace, PowerEnv env) {
    float aspect = iResolution.x / iResolution.y;
    // Feature extents on the face (fractions of half-height/width) —
    // never thinner than the beam spot itself.
    float spotV = max(env.vSpan, 0.006) * (1.0 + 0.6 * (env.focusMul - 1.0));
    float spotH = max(env.hSpan, 0.006 / aspect);

    // Vertical gaussian: the dying V-deflection's residual span.
    float gy = exp(-0.5 * (pFace.y / spotV) * (pFace.y / spotV));

    vec3 content;
    if (env.hSpan > 0.5) {
        // LINE: horizontal deflection alive — full-width bright line,
        // column u still maps across the picture.
        float u = clamp(pFace.x * 0.5 + 0.5, 0.0, 1.0);
        content = collapseLine(u);
    } else {
        // DOT: both axes dead — everything lands in one spot.
        float gx = exp(-0.5 * (pFace.x / spotH) * (pFace.x / spotH));
        content = collapseAll();
        gy *= gx;
    }

    // A saturated core with a soft halation skirt (the overdriven spot
    // scatters hard in the glass).
    float skirt = exp(-0.5 * (pFace.y / (spotV * 6.0)) * (pFace.y / (spotV * 6.0)));
    if (env.hSpan <= 0.5) {
        float sx = exp(-0.5 * (pFace.x / (spotH * 6.0)) * (pFace.x / (spotH * 6.0)));
        skirt *= sx;
    }
    // Phosphor saturation: the core clips toward white-ish rather than
    // scaling forever (real spots read as white even on dim content).
    vec3 core = content * env.bright;
    float coreLum = dot(core, LUMA);
    core = mix(core, vec3(coreLum), smoothstep(1.5, 6.0, coreLum) * 0.5);

    return core * gy + core * skirt * 0.12;
}

// --------------------------------------------------------------------------
// Halation & diffusion: light scattered inside the faceplate re-emerges
// as a wide desaturated halo; phosphor-grain/glass scatter adds a tight
// colored glow. Sampled from the state texture (the lit phosphor).
// --------------------------------------------------------------------------
vec3 glassGlow(vec2 cuv) {
    if (CRT_HALATION <= 0.0 && CRT_DIFFUSION <= 0.0) return vec3(0.0);
    vec2 res = iResolution.xy;
    vec3 tight = vec3(0.0);
    vec3 wide = vec3(0.0);
    const int N = 12;
    // Rotate the whole tap constellation per pixel and per frame.
    // Real scatter is a continuum; with a fixed 12-tap kernel a small
    // isolated source (the cursor) reads as 12 discrete ghost copies.
    // Jittering the spiral's phase decorrelates neighboring pixels and
    // successive frames, so the same 12 taps integrate — spatially and
    // in the eye — into the smooth annular halo the physics predicts.
    float rot = hash12(cuv * res + vec2(fract(iTime * 13.0) * 289.0,
                                        fract(iTime * 7.0) * 331.0))
                * 6.2831853;
    for (int i = 0; i < N; i++) {
        float a = float(i) * 2.39996 + rot; // golden angle + jitter phase
        float r = sqrt((float(i) + 0.5) / float(N));
        vec2 d = vec2(cos(a), sin(a)) * r;
        vec3 sT = contentAt(cuv + d * (0.012 * res.y) / res);
        vec3 sW = contentAt(cuv + d * (0.055 * res.y) / res);
        tight += sT;
        wide += sW;
    }
    tight /= float(N);
    wide /= float(N);
    float wLum = dot(wide, LUMA);
    // Halation is desaturated (multiple scatter) — mix toward its luma.
    vec3 halo = mix(wide, vec3(wLum), 0.6);
    return tight * CRT_DIFFUSION + halo * CRT_HALATION;
}

// --------------------------------------------------------------------------
// Color-selection mask, locked to OUTPUT pixels. Monochrome tubes have a
// continuous phosphor coating: no mask, enforced at compile time.
// --------------------------------------------------------------------------
#if !CRT_MONO && CRT_MASK_TYPE != 0

vec3 maskWeight(vec2 fragCoord) {
    float triadPx = iResolution.x / float(CRT_MASK_TRIADS);
    float dark = 1.0 - CRT_MASK_STRENGTH;

  #if CRT_MASK_TYPE == 1
    // Aperture grille: continuous vertical RGB stripes, no vertical
    // structure at all (Trinitron).
    float ph = fract(fragCoord.x / triadPx) * 3.0;
    vec3 m = vec3(dark);
    if (ph < 1.0) m.r = 1.0; else if (ph < 2.0) m.g = 1.0; else m.b = 1.0;
    return m;
  #elif CRT_MASK_TYPE == 2
    // Slot mask: RGB stripe columns interrupted by tie bars, staggered
    // half a slot between adjacent triad columns (the "brick" pattern).
    float col = fragCoord.x / triadPx;
    float ph = fract(col) * 3.0;
    vec3 m = vec3(dark);
    if (ph < 1.0) m.r = 1.0; else if (ph < 2.0) m.g = 1.0; else m.b = 1.0;
    float slotH = triadPx * 1.35;
    float stag = step(1.0, mod(floor(col), 2.0)) * 0.5;
    float bar = fract(fragCoord.y / slotH + stag);
    float barW = max(1.0 / slotH, 0.10);
    if (bar < barW) m *= mix(1.0, 0.25, CRT_MASK_STRENGTH);
    return m;
  #else
    // Delta shadow mask: hexagonally packed round triads; adjacent rows
    // offset half a triad (the honeycomb seen up close on delta tubes).
    float rowH = triadPx * 0.866;
    float row = floor(fragCoord.y / rowH);
    float xoff = mod(row, 2.0) * 0.5;
    vec2 cell = vec2(fragCoord.x / triadPx + xoff, fragCoord.y / rowH);
    vec2 f = fract(cell);
    float ph = f.x * 3.0;
    vec3 m = vec3(dark);
    if (ph < 1.0) m.r = 1.0; else if (ph < 2.0) m.g = 1.0; else m.b = 1.0;
    // Round the dots: darken toward cell vertical edges.
    float dotShape = smoothstep(0.5, 0.32, abs(f.y - 0.5));
    m = mix(vec3(dark * 0.85), m, dotShape);
    return m;
  #endif
}

#endif // mask

// Damper wires: 1-2 faint horizontal shadows across an aperture grille
// (auto: one at 2/3 for small tubes, two at 1/3 & 2/3 for large).
float damperWires(float v) {
#if !CRT_MONO && CRT_MASK_TYPE == 1 && CRT_DAMPER_WIRES != 0
    float n;
  #if CRT_DAMPER_WIRES == 3
    n = (float(CRT_MASK_TRIADS) > 520.0) ? 2.0 : 1.0;
  #else
    n = float(CRT_DAMPER_WIRES);
  #endif
    float wirePx = max(iResolution.y * 0.0009, 1.0);
    float w = wirePx / iResolution.y;
    float shade = 1.0;
    if (n < 1.5) {
        shade *= 1.0 - 0.35 * (1.0 - smoothstep(0.0, w, abs(v - 0.667)));
    } else {
        shade *= 1.0 - 0.35 * (1.0 - smoothstep(0.0, w, abs(v - 0.333)));
        shade *= 1.0 - 0.35 * (1.0 - smoothstep(0.0, w, abs(v - 0.667)));
    }
    return shade;
#else
    return 1.0;
#endif
}

#if CRT_PDP
// --------------------------------------------------------------------------
// Plasma cell grid: vertical RGB subcell apertures between barrier ribs,
// dominated by the horizontal black stripe between rows (the opposite
// emphasis of a CRT grille — this is what makes a PDP look like a PDP
// up close). Fill-factor compensation follows the CRT mask approach.
// --------------------------------------------------------------------------
vec3 pdpMask(vec2 fragCoord, vec3 emitted) {
    float cellW = iResolution.x / float(CRT_MASK_TRIADS);
    vec2 f = fract(fragCoord / max(cellW, 1.0));
    float hOpen = smoothstep(0.26, 0.34, f.y);
    float sub = fract(f.x * 3.0);
    float vOpen = smoothstep(0.08, 0.16, sub) * (1.0 - smoothstep(0.84, 0.92, sub));
    float ph = floor(f.x * 3.0);
    vec3 m = vec3(0.0);
    if (ph < 0.5) m.r = 1.0; else if (ph < 1.5) m.g = 1.0; else m.b = 1.0;
    vec3 open = m * hOpen * vOpen;
    // Luminance-faded strength + fill-factor gain (avg transmission
    // ~0.17/channel at full strength).
    float lum = clamp(dot(emitted, LUMA), 0.0, 1.0);
    float strength = CRT_MASK_STRENGTH * (1.0 - CRT_MASK_FADE * lum);
    return mix(vec3(1.0), open * 2.0, strength);
}

const float PDP_BAYER[16] = float[16](
    0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0,
    3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);
#endif

// --------------------------------------------------------------------------
// Burn-in: efficiency loss from the accumulated dose (state alpha), plus
// an optional pre-aged pattern (years of terminal ghosts: text rows, a
// prompt column, center panel wear).
// --------------------------------------------------------------------------
float burnEfficiency(vec2 cuv, float dose) {
    float wear = smoothstep(0.0, 1.0, dose);
#if defined(CRT_BURNIN_VINTAGE)
    if (CRT_BURNIN_VINTAGE > 0.0) {
        // 24 text rows etched in with varying strength; status rows and
        // the left margin took the most beam over the years.
        float rows = 24.0;
        float rowPh = fract(cuv.y * rows);
        float rowGhost = smoothstep(0.15, 0.5, rowPh) * smoothstep(0.85, 0.5, rowPh);
        float rowWeight = 0.35
            + 0.65 * step(cuv.y, 1.0 / rows)            // status line
            + 0.45 * step(1.0 - 1.0 / rows, cuv.y);     // title line
        float margin = smoothstep(0.10, 0.02, cuv.x) * 0.5;
        vec2 c = cuv - 0.5;
        float panel = exp(-dot(c * vec2(1.0, 1.4), c * vec2(1.0, 1.4)) * 2.2) * 0.4;
        float vintage = clamp(rowGhost * rowWeight * 0.55 + margin + panel, 0.0, 1.0);
        wear = max(wear, vintage * CRT_BURNIN_VINTAGE * 0.8);
    }
#endif
    return 1.0 - 0.35 * CRT_BURNIN_VISIBILITY * wear;
}

// --------------------------------------------------------------------------
// White point: D65 (identity — sRGB shares the P22 primaries) toward the
// D93 bluish white of Japanese consumer tubes.
// --------------------------------------------------------------------------
vec3 whitePoint(vec3 c) {
#if CRT_MONO
    return c;
#else
    float t = clamp((CRT_COLOR_TEMP - 6500.0) / (9300.0 - 6500.0), -1.0, 1.0);
    vec3 gains = (t >= 0.0)
        ? mix(vec3(1.0), vec3(0.882, 0.955, 1.180), t)
        : mix(vec3(1.0), vec3(1.115, 1.010, 0.845), -t);
  #if CRT_PHOSPHOR == 1
    // p22_d93 preset: the tube itself ships cold regardless of the knob.
    gains *= vec3(0.94, 0.99, 1.06);
  #endif
    return c * gains;
#endif
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 res = iResolution.xy;

    // Global initializers do not reliably survive the glslang ->
    // spirv-cross round trip (Mesa warns "used uninitialized"), so the
    // content-source globals are assigned explicitly per invocation.
    g_contentMode = 0;
    g_seq = 0.0;
    g_aspect = res.x / res.y;
    g_shiftY = 0.0;
    g_ilOffset = 0.0;
#if CRT_INTERLACE && !CRT_DVST
    // Spatial fallback only when the panel cannot carry real fields.
    if (_CRT_CH0(vec2(4.5, 0.5) / res).g < CRT_SCAN_RATE * 0.95) {
        g_ilOffset = 0.5 * float(iFrame & 1);
    }
#endif

    // ---- state machine reads ----
    vec4 sP0 = _CRT_CH0(vec2(0.5, 0.5) / res);
    vec4 sP1 = _CRT_CH0(vec2(1.5, 0.5) / res);
    float seqClock = sP0.r;
    float powerNonce = sP0.g;
    float powerState = sP0.a;
    float warmClock = sP1.r;
    float apl = sP1.g;
    float dgClock = sP1.b;

#if CRT_DEBUG_STATE
    fragColor = vec4(_CRT_CH0(fragCoord / res).rgb, 1.0);
    return;
#endif

    // Degauss envelope: PTC thermistor decay, done in ~2 s. Auto-fires
    // at power-on for solid-state eras; the panel button replays it.
    float dgAuto = 0.0;
#if CRT_ERA >= 1
    if (powerState > 0.5) dgAuto = exp(-seqClock / 0.45);
#endif
    float dgWobble = max(exp(-dgClock / 0.45) * step(dgClock, 2.5), dgAuto);

    PowerEnv env = powerEnvelope(seqClock, warmClock, powerState, powerNonce);

    // Fully dark tube: bezel-black with the faintest glass reflection.
    if (env.black > 0.5) {
        fragColor = vec4(vec3(0.0035 * (1.0 - CRT_GLASS_TINT)), 1.0);
        return;
    }

    // Deep deflection collapse (power on/off dot & line phases): once the
    // residual span compresses many content rows into each screen pixel,
    // the picture must be INTEGRATED into the line/dot, not decimated.
    // Above this threshold the normal path's squash mapping is correct
    // (rows are still individually resolvable on screen).
    if (env.vSpan < 0.18) {
        vec2 pC = fragCoord / res * 2.0 - 1.0;
        vec3 lightC = collapseLight(pC, env);
#if CRT_MONO
  #if CRT_PHOSPHOR == 9
        vec3 emittedC = lightC.r * PH_TINT + lightC.g * P7_YELLOW;
  #else
        vec3 emittedC = lightC.r * PH_TINT
            + vec3(dot(lightC, LUMA)) * smoothstep(2.0, 8.0, dot(lightC, LUMA)) * 0.3;
  #endif
#else
        vec3 emittedC = whitePoint(lightC);
#endif
#if !CRT_MONO && CRT_MASK_TYPE != 0
        emittedC *= maskWeight(fragCoord);
#endif
        emittedC *= CRT_GLASS_TINT;
        vec2 qC = abs(pC) - (1.0 - CRT_CORNER_RADIUS);
        float cdC = length(max(qC, 0.0)) + min(max(qC.x, qC.y), 0.0) - CRT_CORNER_RADIUS;
        float cmC = 1.0 - smoothstep(-0.004, 0.002, cdC);
        emittedC *= cmC;
        emittedC += vec3(0.0035 * (1.0 - CRT_GLASS_TINT) * cmC);
        fragColor = vec4(max(emittedC, 0.0), 1.0);
        return;
    }

#if CRT_DVST
    // ------------------------------------------------------------------
    // Storage tube: strokes on a flood-lit field. No raster, therefore
    // no scanlines, no sync errors, no hum bar, no retrace — stillness
    // was the entire point of a DVST.
    // ------------------------------------------------------------------
    {
        vec2 pD = fragCoord / res * 2.0 - 1.0;
        vec2 cuvD = warpToContent(pD, env, apl, 0.0);
        if (cuvD.x < 0.0 || cuvD.x > 1.0 || cuvD.y < 0.0 || cuvD.y > 1.0) {
            fragColor = vec4(vec3(0.0035 * (1.0 - CRT_GLASS_TINT)), 1.0);
            return;
        }

        // Writing-beam spot: slight gaussian softness, no line structure.
        cuvD.y = max(cuvD.y, 2.5 / res.y);
        vec2 px = 1.0 / res;
        vec4 s = stateAt(cuvD) * 0.4
               + stateAt(cuvD + vec2(px.x, 0.0)) * 0.15
               + stateAt(cuvD - vec2(px.x, 0.0)) * 0.15
               + stateAt(cuvD + vec2(0.0, px.y)) * 0.15
               + stateAt(cuvD - vec2(0.0, px.y)) * 0.15;

        // Freshly written strokes bloom: scattered secondaries lift the
        // neighborhood toward threshold for a moment.
        float halo = 0.0;
        for (int i = 0; i < 4; i++) {
            float a = float(i) * 1.5708 + 0.7854;
            halo += stateAt(cuvD + vec2(cos(a), sin(a)) * 6.0 * px).g;
        }
        halo *= 0.25;

        vec3 emitted =
            clamp(s.r, 0.0, 1.2) * PH_TINT * 0.5      // stored trace
            + s.g * DVST_FLASH_TINT * 1.1              // writing flash
            + halo * DVST_FLASH_TINT * 0.18
  #if CRT_DVST_ORANGE_REFRESH
            + s.b * DVST_ORANGE * 0.55;                // Opt 31 refresh
  #else
            + s.b * PH_TINT * 0.75;                    // write-thru green
  #endif

        // Flood-gun background glow: the screen is never black in view
        // mode (stored:background only 10:1).
        emitted += PH_TINT * DVST_BG_GLOW * env.bright;

  #if CRT_DVST_HOLD_DIM
        // 4010 hold mode: ~90 s idle -> flood pulsed to ~1/8 brightness.
        float idle = iTime - iTimeCursorChange;
        if (idle > 90.0) {
            emitted *= mix(1.0, 0.15, smoothstep(90.0, 93.0, idle));
        }
  #endif

        // Burn-in: ghost menus of held pages.
        emitted *= burnEfficiency(cuvD, s.a);

        emitted *= env.bright * CRT_GLASS_TINT;
        float rEdgeD = length(pD);
        emitted *= 1.0 - CRT_BEZEL * smoothstep(0.82, 1.12, rEdgeD);
        vec2 qD = abs(pD) - (1.0 - CRT_CORNER_RADIUS);
        float cdD = length(max(qD, 0.0)) + min(max(qD.x, qD.y), 0.0) - CRT_CORNER_RADIUS;
        float cmD = 1.0 - smoothstep(-0.004, 0.002, cdD);
        emitted *= cmD;
        emitted += vec3(0.0035 * (1.0 - CRT_GLASS_TINT) * cmD);
        fragColor = vec4(max(emitted, 0.0), 1.0);
        return;
    }
#endif

#if CRT_VECTOR_MODE != 0
    // ------------------------------------------------------------------
    // Vector / XY tube: the beam is steered directly in XY and writes
    // phosphor strokes — there is no line raster, so scanlines, interlace,
    // rolling scan, sync tear (V/H-hold), hum bar, retrace, and smooth-scroll
    // glide are all meaningless and disabled. KEPT: warp geometry (vector
    // tubes pincushioned WORSE than raster — the Vectrex is famous for it),
    // glass/bezel/corner, burn-in (Asteroids score-digit ghosts), power
    // collapse-to-dot (handled above — MORE authentic here), EMI wobble, and
    // degauss (colour vector). Structurally parallel to the DVST carve-out.
    // ------------------------------------------------------------------
    {
        vec2 pV = fragCoord / res * 2.0 - 1.0;
        vec2 cuvV = warpToContent(pV, env, apl, dgWobble);
        if (CRT_EMI_WOBBLE > 0.0) {
            cuvV.x += CRT_EMI_WOBBLE * 0.0012
                * sin(cuvV.y * 19.0 + iTime * 61.7)
                * (0.6 + 0.4 * sin(iTime * 0.73));
        }
        if (cuvV.x < 0.0 || cuvV.x > 1.0 || cuvV.y < 0.0 || cuvV.y > 1.0) {
            fragColor = vec4(vec3(0.0035 * (1.0 - CRT_GLASS_TINT)), 1.0);
            return;
        }
        cuvV.y = max(cuvV.y, 2.5 / res.y);
        float rEdgeV = length(pV);
        float cornerSoftV = 1.0 + 0.5 * smoothstep(0.55, 1.25, rEdgeV);
        float focusMulV = CRT_FOCUS * env.focusMul;
        vec2 pxV = 1.0 / res;

        // ---- beam core: tight Gaussian spot of the excitation state ----
        // (The thin brilliant centre of the stroke; energy grows the spot.)
        float coreSig = max(CRT_VECTOR_BEAM_CORE * focusMulV * cornerSoftV, 0.45);
        vec3 core = vec3(0.0);
        float coreG = 0.0;
        float wc = 0.0;
        for (int y = -2; y <= 2; y++) {
            for (int x = -2; x <= 2; x++) {
                vec2 d = vec2(float(x), float(y));
                float w = exp(-0.5 * dot(d, d) / (coreSig * coreSig));
                vec4 s = stateAt(cuvV + d * pxV);
                core += s.rgb * w;
                coreG += s.g * w;
                wc += w;
            }
        }
        core /= max(wc, 1e-4);
        coreG /= max(wc, 1e-4);
        float doseV = stateAt(cuvV).a;

#if !CRT_MONO
        // Colour vector (P22 shadow-mask tube): static R/B landing error,
        // worse toward the corners — the Tempest/Star Wars edge fringing.
        float convPxV = CRT_MISCONVERGENCE * cornerSoftV;
        if (convPxV > 0.05) {
            core.r = mix(core.r, stateAt(cuvV + vec2( convPxV * pxV.x, 0.0)).r, 0.7);
            core.b = mix(core.b, stateAt(cuvV + vec2(-convPxV * pxV.x, 0.0)).b, 0.7);
        }
#endif

        // ---- wide halo: gaussian ring lattice, gain per dossier (>> raster)
        // Vector monitors bloom far more than raster tubes (MAME sets vector
        // bloom well above its raster default): a slow bright beam dumps a lot
        // of energy into the glass.
        //
        // The taps are a STRATIFIED ring lattice. Sparse sampling of a glow
        // this wide (~0.03 * height, tens of pixels) fails in one of two ways,
        // and both were observed here:
        //
        //   * A per-pixel randomly rotated golden-angle set -- 12 taps, each
        //     neighbouring pixel drawing an independent Monte Carlo estimate
        //     -- turns the glow into a dust storm of speckle. Measured at 4.4x
        //     the horizontal high-frequency energy of the identical frame with
        //     the halo off, and unchanged by zeroing CRT_VECTOR_GRAIN and
        //     CRT_NOISE, which is how it was isolated.
        //   * A fully deterministic lattice removes the speckle but makes each
        //     tap a sharp displaced copy, so strokes grow visible ghost echoes
        //     -- the same artifact the raster glassGlow() hit before it was
        //     jittered.
        //
        // Stratification gets both: every tap keeps its own angular and radial
        // cell and is jittered only WITHIN that cell. No tap can align with
        // its neighbour into a ghost, and the variance is a fraction of the
        // fully-random rotation's because no sample leaves its stratum. The
        // gaussian weight keeps the falloff monotonic, and normalizing by the
        // weight sum means a uniform field returns itself -- so the gain knob
        // keeps the meaning the presets were tuned against.
        vec3 halo = vec3(0.0);
        float haloW = 0.0;
        const int HRINGS = 3;
        const int HSPOKES = 12;
        float hseed = hash12(fragCoord + vec2(fract(iTime * 13.0) * 289.0,
                                              fract(iTime * 7.0) * 331.0));
        for (int r = 0; r < HRINGS; r++) {
            for (int s = 0; s < HSPOKES; s++) {
                // Jitter inside this tap's own cell: +-half a spoke in angle,
                // +-half a ring in radius. Decorrelate the two axes so the
                // jitter does not collapse onto a diagonal.
                float j1 = fract(hseed + float(r) * 0.618034 + float(s) * 0.381966);
                float j2 = fract(hseed * 1.61803 + float(s) * 0.754878 + float(r) * 0.24698);
                float rr = (float(r) + j2) / float(HRINGS);
                float rad = rr * 0.03 * res.y;
                float a = (float(s) + j1) * (2.0 * PI / float(HSPOKES));
                float wgt = exp(-2.0 * rr * rr);
                vec2 d = vec2(cos(a), sin(a)) * rad / res;
                halo += stateAt(cuvV + d).rgb * wgt;
                haloW += wgt;
            }
        }
        halo /= max(haloW, 1e-4);

        // ---- phosphor emission ----
        vec3 emittedV;
#if CRT_MONO
        float eV = core.r + halo.r * CRT_VECTOR_BEAM_HALO;
        emittedV = eV * PH_TINT;
        // Additive saturation to white at the brightest strokes: an
        // overdriven spot reads white regardless of the phosphor colour.
        emittedV = mix(emittedV, vec3(eV), smoothstep(0.9, 1.6, core.r) * 0.6);
        // Dwell dots: endpoint/corner energy from the G slot, rendered as
        // bright near-white points with their own glow.
        float dwellDot = coreG * CRT_VECTOR_DOT_GAIN;
        emittedV += dwellDot * mix(PH_TINT, vec3(1.0), 0.5);
#else
        vec3 e3V = core + halo * CRT_VECTOR_BEAM_HALO;
        emittedV = whitePoint(e3V);
        float lumV = dot(core, LUMA);
        emittedV = mix(emittedV, vec3(lumV), smoothstep(1.0, 1.8, lumV) * 0.5);
#endif

        // ---- refresh-vs-load flicker beat (stroke density from apl) ----
        // The vector display-list slowdown: a busier screen droops and beats
        // harder. Honest 60Hz-panel slow-beat stand-in (see params note).
        emittedV *= 1.0 + CRT_VECTOR_FLICKER * (0.4 + 1.6 * apl)
                        * sin(2.0 * PI * 9.7 * iTime);

        // ---- signal snow (frame-wide; per-stroke grain was pass 1) ----
        if (CRT_NOISE > 0.0) {
            float n = hash12(fragCoord + vec2(fract(iTime * 7.0) * 331.0));
            emittedV *= 1.0 + CRT_NOISE * 2.0 * (n - 0.5);
        }

        // ---- power/warmup envelope + burn-in (Asteroids ghosts) ----
        emittedV *= env.bright;
        emittedV *= burnEfficiency(cuvV, doseV);

        // ---- colour-vector mask on the strokes (mono forces none) ----
#if !CRT_MONO && CRT_MASK_TYPE != 0
        vec3 mwV = maskWeight(fragCoord);
        float lumMaskV = clamp(dot(emittedV, LUMA), 0.0, 1.0);
        mwV = mix(mwV, vec3(1.0), CRT_MASK_FADE * lumMaskV);
        float avgTV = mix(1.0, 1.0 / 3.0 + 2.0 / 3.0 * (1.0 - CRT_MASK_STRENGTH), 1.0);
        emittedV *= mwV * mix(1.0, 1.0 / max(avgTV, 0.34), CRT_MASK_STRENGTH * 0.85);
#endif

        // ---- glass: faceplate tint, bezel, corner, ambient floor ----
        emittedV *= CRT_GLASS_TINT;
        emittedV *= 1.0 - CRT_BEZEL * smoothstep(0.82, 1.12, rEdgeV);
        vec2 qV = abs(pV) - (1.0 - CRT_CORNER_RADIUS);
        float cdV = length(max(qV, 0.0)) + min(max(qV.x, qV.y), 0.0) - CRT_CORNER_RADIUS;
        float cmV = 1.0 - smoothstep(-0.004, 0.002, cdV);
        emittedV *= cmV;
        emittedV += vec3(0.0035 * (1.0 - CRT_GLASS_TINT) * cmV);
        fragColor = vec4(max(emittedV, 0.0), 1.0);
        return;
    }
#endif

#if CRT_PDP
    // ------------------------------------------------------------------
    // Plasma panel: fixed digital cell grid — no beam, no scanlines, no
    // sync, no deflection error. Artifacts live in TIME (subfield PWM):
    // dither crawl, moving-gradient contouring (applied in the state
    // pass), green-lag trails (the decay engine), priming black floor,
    // large-area flicker, and ABL.
    // ------------------------------------------------------------------
    {
        vec2 pP = fragCoord / res * 2.0 - 1.0;
        vec2 cuvP = warpToContent(pP, env, apl, 0.0);
        if (cuvP.x < 0.0 || cuvP.x > 1.0 || cuvP.y < 0.0 || cuvP.y > 1.0) {
            fragColor = vec4(vec3(0.002), 1.0);
            return;
        }
        cuvP.y = max(cuvP.y, 2.5 / res.y);
        vec4 s = _CRT_CH0(cuvP);
        vec3 lightP = s.rgb;

        // Priming-discharge black floor: warm neon/phosphor glow.
        vec3 floorC = vec3(1.0, 0.85, 0.6) * CRT_PDP_BLACK_FLOOR;
        lightP = max(lightP, floorC * env.bright);

        // Near-black spatiotemporal dither: whole cells flicker on a
        // rotating ordered pattern (cells are binary per subfield).
        if (CRT_PDP_DITHER > 0.0) {
            float lum = dot(lightP, LUMA);
            if (lum < 0.05) {
                float cellW = res.x / float(CRT_MASK_TRIADS);
                vec2 cell = floor(fragCoord / max(cellW, 1.0));
                int bi = int(mod(cell.x + mod(float(iFrame / 2), 2.0) * 2.0, 4.0))
                       + 4 * int(mod(cell.y + mod(float(iFrame / 4), 2.0), 4.0));
                float thresh = (PDP_BAYER[bi] + 0.5) / 16.0;
                float lsb = 0.008 * CRT_PDP_DITHER;
                float q = (floor(lum / lsb) + step(thresh, fract(lum / lsb))) * lsb;
                lightP *= q / max(lum, 1e-5);
            }
        }

        vec3 emittedP = whitePoint(lightP) * env.bright;
        emittedP *= pdpMask(fragCoord, emittedP);
        emittedP *= burnEfficiency(cuvP, s.a);
        // Large-area sustain flicker: whole lit field pulses together.
        emittedP *= 1.0 + CRT_FLICKER * 2.0 * sin(2.0 * PI * 9.7 * iTime)
                        * smoothstep(0.15, 0.45, dot(emittedP, LUMA));
        emittedP *= CRT_GLASS_TINT;
        vec2 qP = abs(pP) - (1.0 - CRT_CORNER_RADIUS);
        float cdP = length(max(qP, 0.0)) + min(max(qP.x, qP.y), 0.0) - CRT_CORNER_RADIUS;
        float cmP = 1.0 - smoothstep(-0.004, 0.002, cdP);
        emittedP *= cmP * (1.0 - CRT_BEZEL * smoothstep(0.85, 1.12, length(pP)));
        fragColor = vec4(max(emittedP, 0.0), 1.0);
        return;
    }
#endif

    // ---- geometry ----
    vec2 p = fragCoord / res * 2.0 - 1.0;
    vec2 pFace = p; // tube-face coords for corner/bezel/wires
    vec2 cuv = warpToContent(p, env, apl, dgWobble);

    // EMI wobble: environmental field jitter (perceptual-rate stand-in).
    if (CRT_EMI_WOBBLE > 0.0) {
        cuv.x += CRT_EMI_WOBBLE * 0.0012
            * sin(cuv.y * 19.0 + iTime * 61.7)
            * (0.6 + 0.4 * sin(iTime * 0.73));
    }

    // ---- sync errors ----
    float vbiShade = vHoldRoll(cuv.y, env.roll);
    float syncShade = vbiShade * hHoldTear(cuv.x, cuv.y);

    // Out-of-raster: beyond deflection span there is no beam.
    if (cuv.x < 0.0 || cuv.x > 1.0 || cuv.y < 0.0 || cuv.y > 1.0) {
        fragColor = vec4(vec3(0.0035 * (1.0 - CRT_GLASS_TINT)), 1.0);
        return;
    }

    // Corner focus loss: off-axis beam lands astigmatic (~1.5x center).
    float rEdge = length(pFace);
    float cornerSoft = 1.0 + 0.5 * smoothstep(0.55, 1.25, rEdge);
    float focusMul = CRT_FOCUS * env.focusMul;

    // ---- content source setup (POST overlay, smooth-scroll glide) ----
    g_aspect = res.x / res.y;
#if CRT_POST_TEST != 0
    if (powerState > 0.5 && postLuma(vec2(0.5), seqClock, g_aspect) >= 0.0) {
        g_contentMode = 1;
        g_seq = seqClock;
    }
#endif
#if CRT_SMOOTH_SCROLL
    // Glide distance queued by the state pass (data pixel P3), consumed
    // at the DECSCLM rate. Positive = content just jumped up; we show it
    // from further down and let it catch up one scan line per frame.
    g_shiftY = _CRT_CH0(vec2(3.5, 0.5) / res).r / res.y;
#endif

    // ---- beam ----
    vec3 light = scanSample(cuv, focusMul, cornerSoft);
    if (CRT_VECTOR_TRACE > 0.0) {
        light = mix(light, vectorSample(cuv, focusMul, cornerSoft),
                    clamp(CRT_VECTOR_TRACE, 0.0, 1.0));
    }
    light += radarInstrumentLight(cuv, pFace) * env.bright;

    // Degauss purity swim: the wobbling field also bends the three beams
    // differently — colors shimmy apart briefly.
#if !CRT_MONO
    if (dgWobble > 0.003) {
        vec2 sw = vec2(dgWobble * 0.004 * sin(iTime * 53.0 + cuv.y * 9.0), 0.0);
        light.r = mix(light.r, stateAt(cuv + sw).r, 0.6);
        light.b = mix(light.b, stateAt(cuv - sw).b, 0.6);
    }
#endif

    // ---- glass scatter ----
    light += glassGlow(cuv);

    // ---- G2 / SCREEN pot: raster lift and retrace lines ----
    // Retrace diagonals appear via a hot G2 (physical path) or the
    // dedicated RETRACE knob (forced, as with failed VBI blanking).
    float g2Lift = max(CRT_G2_SCREEN - 0.55, 0.0) * 2.2;
    float retraceAmt = max(g2Lift * 0.10, CRT_RETRACE_LINES * 0.14);
    if (g2Lift > 0.0 || retraceAmt > 0.0) {
        float lift = g2Lift * 0.05 * env.bright;
        // Vertical-retrace diagonals: the beam snapping back up-left
        // during VBI. ~13 visible sweeps, slanting up to the right.
        float ph = fract(cuv.y * 13.0 + cuv.x * 1.6);
        float lines = smoothstep(0.97, 1.0, ph) * retraceAmt * env.bright;
        light += vec3(lift + lines);
    }

    // ---- power/thermal envelope, sync bars ----
    light *= env.bright * syncShade;

    // ---- hum bar ----
    if (CRT_HUM_AMP > 0.0) {
        float bandY = fract(iTime / CRT_HUM_PERIOD);
        float d = abs(fract(cuv.y - bandY + 0.5) - 0.5);
        float band = exp(-d * d / (2.0 * 0.05 * 0.05));
        light *= 1.0 - CRT_HUM_AMP * band;
    }

    // ---- flicker (slow-beat cosmetic stand-in; see params.json note) ----
    light *= 1.0 + CRT_FLICKER * sin(2.0 * PI * 9.7 * iTime);

    // ---- signal noise ----
    if (CRT_NOISE > 0.0) {
        float n = hash12(fragCoord + vec2(fract(iTime * 7.0) * 331.0));
        light *= 1.0 + CRT_NOISE * 2.0 * (n - 0.5);
    }

    // ---- burn-in ----
    float dose = stateAt(vec2(cuv.x, cuv.y - g_shiftY)).a;
    light *= burnEfficiency(cuv, dose);

    // ---- phosphor emission color ----
#if CRT_MONO
  #if CRT_PHOSPHOR == 9
    vec3 emitted = light.r * PH_TINT + light.g * P7_YELLOW;
  #else
    float e = light.r;
    vec3 emitted = e * PH_TINT;
    // Slight whitening under heavy overdrive (saturating centers).
    emitted = mix(emitted, vec3(e), smoothstep(0.9, 1.6, e) * 0.22);
  #endif
#else
    vec3 emitted = whitePoint(light);
#endif

    // ---- mask ----
#if !CRT_MONO && CRT_MASK_TYPE != 0
    vec3 mw = maskWeight(fragCoord);
    // Brightness restoration: luminance-faded mask (zfast technique) +
    // gain toward the mask's average transmission.
    float lum = clamp(dot(emitted, LUMA), 0.0, 1.0);
    mw = mix(mw, vec3(1.0), CRT_MASK_FADE * lum);
    float avgT = mix(1.0, 1.0 / 3.0 + 2.0 / 3.0 * (1.0 - CRT_MASK_STRENGTH), 1.0);
    emitted *= mw * mix(1.0, 1.0 / max(avgT, 0.34), CRT_MASK_STRENGTH * 0.85);
#endif

    // Damper wire shadows ride the tube face.
    emitted *= damperWires(fragCoord.y / res.y);

    // ---- glass: faceplate tint, bezel, ambient floor ----
    emitted *= CRT_GLASS_TINT;
    float bezelShade = 1.0 - CRT_BEZEL * smoothstep(0.82, 1.12, rEdge);
    emitted *= bezelShade;

    // Corner rounding of the tube face.
    vec2 q = abs(pFace) - (1.0 - CRT_CORNER_RADIUS);
    float cornerDist = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - CRT_CORNER_RADIUS;
    float cornerMask = 1.0 - smoothstep(-0.004, 0.002, cornerDist);
    emitted *= cornerMask;

    // Ambient reflection floor: the glass is never perfectly black.
    emitted += vec3(0.0035 * (1.0 - CRT_GLASS_TINT) * cornerMask);

    fragColor = vec4(max(emitted, 0.0), 1.0);
}

void main()
{
    vec2 _fc = vec2(vTexCoord.x, 1.0 - vTexCoord.y)
             * params.OutputSize.xy;
    mainImage(FragColor, _fc);
    // Ghostty's GL pipeline gamma-encoded on write
    // (FRAMEBUFFER_SRGB); RetroArch expects encoded output.
    FragColor.rgb = pow(clamp(FragColor.rgb, 0.0, 1.0),
                        vec3(1.0 / 2.2));
}
