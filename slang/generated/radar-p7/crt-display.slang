  const vec3 P7_YELLOW = vec3(0.517, 0.678, 0.101); // P7 persistent layer
#elif CRT_PHOSPHOR == 10
  const vec3 PH_TINT = vec3(0.043, 0.101, 1.000);   // P11 blue
