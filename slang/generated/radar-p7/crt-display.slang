// y-up convention bridge: the templates use GL bottom-left
// origin; slang vTexCoord is top-left. Flip at every boundary.
vec4 crtTexA(sampler2D t, vec2 uv) {
    return texture(t, vec2(uv.x, 1.0 - uv.y));
}
#define _CRT_CH0(uv) crtTexA(Source, uv)
#define _CRT_CH1(uv) vec4(0.0)
// ============================================================================
// CRT SIMULATION — PASS 2 of 2: DISPLAY (deflection, mask, glass)
// ============================================================================
// Ghostty custom shader; chained after phosphor-state.glsl. iChannel0 is
// the phosphor state texture (RGBA16F linear: RGB = excitation, A = burn-in
// dose; row 0 = state-machine data pixels). This pass is the optical and
// electromagnetic half of the monitor:
//
//   deflection geometry (curvature, pincushion, size/position, rotation)
//   power on/off choreography per era (dot -> line -> raster; collapse)
//   sync errors (V-hold roll with VBI bar, H-hold diagonal tear)
//   scanline structure (gaussian beam, brightness-dependent spot growth)
//   video bandwidth (horizontal softness), deconvergence, interlace
//   the color-selection mask (grille + damper wires / slot / delta) with
//     brightness compensation — and NO mask for monochrome phosphors
//   halation & diffusion, hum bar, EMI wobble, degauss shimmy, HV
//     breathing, ABL interplay, G2 raster lift + retrace lines, glass
//     tint, bezel, burn-in efficiency loss, phosphor emission tinting
//
// All spatial math happens on the warped "tube face" coordinate; masks are
// locked to output pixels (fragCoord) to avoid moire against the panel.
// Physics constants and behaviors cite the research dossier in DESIGN.md.
// ============================================================================





// --------------------------------------------------------------------------
// Phosphor emission tables (linear-light tints; sRGB sources converted).
// CRT_MONO must match the state pass tables.
// --------------------------------------------------------------------------
#if CRT_PHOSPHOR == 0 || CRT_PHOSPHOR == 1 || CRT_PHOSPHOR == 12
  #define CRT_MONO 0
#else
  #define CRT_MONO 1
#endif

#if CRT_PHOSPHOR == 2
  const vec3 PH_TINT = vec3(0.009, 0.835, 0.017);   // P1 willemite green
#elif CRT_PHOSPHOR == 3
