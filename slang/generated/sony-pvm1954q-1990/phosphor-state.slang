// ============================================================================
// CRT SIMULATION — PASS 1 of 2: PHOSPHOR STATE
// ============================================================================
// Ghostty custom shader (requires the phosphor-feedback Ghostty fork, which
// provides iChannel1 = this pass's own output from the previous frame in
// RGBA16F linear light).
//
// This pass is the electrical half of the monitor: video amplifier, electron
// gun, and the phosphor screen itself. It converts terminal content into
// phosphor EXCITATION and evolves that excitation through time using
// measured decay physics. The optical half (deflection geometry, mask,
// glass) is pass 2 (crt-display).
//
// Output encoding (RGBA16F, linear):
//   Content pixels (fragCoord.y >= 1):
//     RGB = per-channel phosphor excitation (0..~2, >1 = overdriven)
//           For monochrome phosphors: R = primary-layer excitation,
//           G = P7 slow (photon-pumped) layer excitation, B = unused.
//     A   = accumulated burn-in dose (Coulomb aging), 0..1
//   Data pixels (fragCoord.y < 1, x < 4) — the shader's state machine:
//     P0 = (seq_clock, stored_power_nonce, stored_degauss_nonce, power_state)
//     P1 = (warm_clock, apl_iir, degauss_clock, initialized_flag)
//
// Physics sources (see crt/DESIGN.md for full citations):
//   - Decay model: sulfide phosphors show a fast near-exponential drop
//     followed by a long power-law tail (Randall & Wilkins 1945). We
//     integrate an exact piecewise-exponential approximation: constant
//     tau_hi above the knee, tau_lo below it, solving for the knee
//     crossing within the frame (no per-frame aliasing).
//   - Constants per phosphor derived from EIA registration data
//     (labguysworld / FH-Muenster tables): P22R Y2O2S:Eu ~1ms line
//     emitter with no tail; P22G ZnS:Cu,Al fast + deep green tail;
//     P39 the 1-10s IBM 5151 smear; P7 photon-pumped slow-rise layer.
//   - Burn-in: efficiency loss proportional to accumulated charge dose
//     (~200 C/cm2 threshold class behavior), time-compressed by the
//     CRT_BURNIN_RATE parameter (documented artistic compression).
//
// The parameter marker line below is replaced by crtctl with the full
// #define block generated from params.json. Do not edit generated files;
// edit the template or turn the knobs.
// ============================================================================





// ---------------------------------------------------------------------------
// Phosphor decay constant tables, selected by CRT_PHOSPHOR.
//   *_TAU_HI : fast-region time constant (seconds)
//   *_KNEE   : excitation level where decay hands off to the tail
//   *_TAU_LO : tail time constant (seconds), scaled by CRT_PERSISTENCE
// Monochrome phosphors set CRT_MONO 1 (pass 2 must not draw an RGB mask).
// ---------------------------------------------------------------------------

#if CRT_PHOSPHOR == 0 || CRT_PHOSPHOR == 1
  // P22 color triad (0 = D65 US/EBU, 1 = D93 Japanese white — pass 2 tints).
  #define CRT_MONO 0
  const vec3 PH_TAU_HI = vec3(0.0010, 0.0004, 0.0003); // R Eu line, G/B ZnS
  const vec3 PH_KNEE   = vec3(0.10, 0.10, 0.08);
  // R: line emitter, tail negligible. G: Cu-activated deep tail (the green
  // afterglow trail). B: short tail. Green tail scaled by CRT_TRAIL_TINT.
#define PH_TAU_LO (vec3(0.003, 0.045 * (0.5 + CRT_TRAIL_TINT), 0.012))
#elif CRT_PHOSPHOR == 2
  // P1 Zn2SiO4:Mn scope green — 20 ms to 10% (class M).
  #define CRT_MONO 1
  const vec3 PH_TAU_HI = vec3(0.0087, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.10, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(0.060, 0.0, 0.0);
#elif CRT_PHOSPHOR == 3
  // P31 ZnS:Cu terminal green — brightest common phosphor, <1 ms, crisp.
  #define CRT_MONO 1
  const vec3 PH_TAU_HI = vec3(0.0003, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.10, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(0.025, 0.0, 0.0);
#elif CRT_PHOSPHOR == 4
  // P39 Zn2SiO4:Mn,As long green (IBM 5151): ~1s-class, scrolling smears.
  #define CRT_MONO 1
  const vec3 PH_TAU_HI = vec3(0.040, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.25, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(1.20, 0.0, 0.0);
#elif CRT_PHOSPHOR == 5
  // P3 amber — 13 ms to 10%.
  #define CRT_MONO 1
  const vec3 PH_TAU_HI = vec3(0.0056, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.10, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(0.040, 0.0, 0.0);
#elif CRT_PHOSPHOR == 6
  // P134-class long-persistence amber (Wyse/DEC terminals).
  #define CRT_MONO 1
  const vec3 PH_TAU_HI = vec3(0.006, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.18, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(0.350, 0.0, 0.0);
#elif CRT_PHOSPHOR == 7
  // P4 B&W TV white: "not over 7% after 33 ms" registration spec.
  #define CRT_MONO 1
  const vec3 PH_TAU_HI = vec3(0.0124, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.07, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(0.080, 0.0, 0.0);
#elif CRT_PHOSPHOR == 8
  // Paper-white (late-80s hi-res mono): sub-ms, essentially crisp.
  #define CRT_MONO 1
  const vec3 PH_TAU_HI = vec3(0.0004, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.08, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(0.020, 0.0, 0.0);
#elif CRT_PHOSPHOR == 9
  // P7 radar cascade: ZnS:Ag blue flash (R slot) + photon-pumped
  // (Zn,Cd)S:Cu yellow layer (G slot) with a perceptible RISE time —
  // the one common phosphor that visibly lags the beam. The real yellow
  // layer persists minutes; tau here is perceptually compressed (see
  // DESIGN.md) and still scales with CRT_PERSISTENCE.
  #define CRT_MONO 1
  #define CRT_P7_CASCADE 1
  const vec3 PH_TAU_HI = vec3(0.00025, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.10, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(0.008, 8.0, 0.0);   // .y = yellow layer decay
  const float P7_RISE_TAU = 0.120;                 // yellow layer rise
#elif CRT_PHOSPHOR == 10
  // P11 photographic blue — 0.01-1 ms class.
  #define CRT_MONO 1
  const vec3 PH_TAU_HI = vec3(0.00015, 0.0, 0.0);
  const vec3 PH_KNEE   = vec3(0.10, 0.0, 0.0);
  const vec3 PH_TAU_LO = vec3(0.005, 0.0, 0.0);
#elif CRT_PHOSPHOR == 11
  // Tektronix DVST: the P1-class willemite screen IS the storage element.
  // Written areas are held lit indefinitely by the flood guns (bistable
  // secondary-emission equilibrium) — decay tables unused; storage logic
  // below replaces the excitation model entirely.
  #define CRT_MONO 1
  #define CRT_DVST 1
  const vec3 PH_TAU_HI = vec3(0.0087, 0.0, 0.0);   // P1 (unused: write flash
  const vec3 PH_KNEE   = vec3(0.10, 0.0, 0.0);     //  decay is modeled with
  const vec3 PH_TAU_LO = vec3(0.060, 0.0, 0.0);    //  DVST_FLASH_TAU)
#elif CRT_PHOSPHOR == 12
  // Plasma display panel: VUV-excited phosphors. Blue BAM <1ms; red
  // (Y,Gd)BO3:Eu ~9ms; green Zn2SiO4:Mn (willemite) ~12ms — the green
  // motion-trail chemistry. Knee at ~0.12 clamps the visible tail to a
  // dim comet, per the measured trail character. Scale with the
  // PERSISTENCE knob for era (1.0=2000, ~0.6=Kuro, ~0.4=ZT60).
  #define CRT_MONO 0
  #define CRT_PDP 1
  const vec3 PH_TAU_HI = vec3(0.0008, 0.0008, 0.0008);
  const vec3 PH_KNEE   = vec3(0.12, 0.12, 0.12);
  const vec3 PH_TAU_LO = vec3(0.014, 0.021, 0.0056);
#else
  #error "Unknown CRT_PHOSPHOR value"
#endif

#ifndef CRT_DVST
#define CRT_DVST 0
#endif
#ifndef CRT_PDP
#define CRT_PDP 0
#endif
#ifndef CRT_VECTOR_MODE
#define CRT_VECTOR_MODE 0
#endif

#if CRT_DVST
// 4010 storage-circuit timings (bitsavers 070-1183-01 sec. 6, Curtin
// SID-1977): PAGE = 12 ms flood-write fade-positive pulse (full-screen
// flash), backplate 180V->0 (light collapses within ~tens of ms), then
// ~700 ms exponential recovery during which nothing can store.
const float DVST_ERASE_FLASH_T   = 0.012;
const float DVST_ERASE_FALL_T    = 0.20;
const float DVST_ERASE_LOCK_T    = 0.75;
const float DVST_FLASH_TAU       = 0.18;   // written-flash settle to stored
const float DVST_STORE_THRESHOLD = 0.35;   // bistable: at/above stores, below never does
const float DVST_WTHRU_LEVEL     = 0.65;   // non-stored refresh brightness vs stored

// Progressive-write clock. A DVST is a RANDOM-ACCESS VECTOR store: the
// writing beam is steered point-to-point and lays each stroke down in
// time, so a page is drawn PROGRESSIVELY, not flashed on all at once, and
// a full screen takes longer to draw than a sparse one (draw time ~=
// total stroke length / stored writing speed). Stored writing speed for
// the bistable graphics tube is SLOW: 1500-4000 vector-inches/second
// (Tek's own rating, ~cm/ms — NOT the cm/us of variable-persistence scope
// tubes), so a dense full page draws in ~1.8-5 s ("several seconds for
// complex pictures"); a bare stroke in milliseconds. See research/
// dvst-writing-dossier.md for the figures and sources these anchor to.
//   T_draw(coverage) = (DVST_WRITE_BASE_T + DVST_WRITE_FULL_T*coverage)
//                      / CRT_DVST_WRITE_RATE
// coverage = measured ink fraction (256-probe, P2.a); knob 1.0 = real-ish.
const float DVST_WRITE_BASE_T    = 0.18;   // sparse-page floor (a few strokes)
const float DVST_WRITE_FULL_T    = 2.30;   // added seconds at a FULL page (fullness 1)
// A full page of TEXT lights only ~5-15% of texels (glyph ink is sparse; the
// auto-erase probe measured ~5% on llvmpipe), so the raw ink fraction is
// remapped to a 0..1 "page fullness" against this documented full-page ink
// reference before it scales the draw time. Honest approximation flagged in
// DESIGN.md: measured ink -> fullness via a fixed reference, not a per-glyph
// stroke-length integral.
const float DVST_WRITE_FULL_COV  = 0.09;   // ink fraction that counts as a full page
const float DVST_WRITE_LR_WEIGHT = 0.06;   // left->right tie-break within the top->bottom sweep
#endif

#ifndef CRT_P7_CASCADE
#define CRT_P7_CASCADE 0
#endif

const float DT_MAX = 0.1; // clamp iTimeDelta: idle gaps must not nuke state

// Rec.601 luma (the CRT-era standard) for mono conversion and dose.
const vec3 LUMA = vec3(0.299, 0.587, 0.114);

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// Exact piecewise-exponential decay over dt: constant tau_hi above the
// knee, tau_lo below. Solves for the knee crossing inside the frame so
// long frames (or long taus) integrate correctly instead of aliasing.
float decayPiecewise(float s, float dt, float tauHi, float knee, float tauLo) {
    if (s <= 0.0) return 0.0;
    float persist = CRT_PERSISTENCE;
    if (persist <= 0.0) return 0.0;
    tauHi *= persist;
    tauLo *= persist;
    if (s > knee) {
        // Time needed to fall from s to the knee at tau_hi:
        float tKnee = tauHi * log(s / knee);
        if (dt <= tKnee) return s * exp(-dt / tauHi);
        // Crossed the knee mid-frame; spend the remainder in the tail.
        return knee * exp(-(dt - tKnee) / tauLo);
    }
    return s * exp(-dt / tauLo);
}

vec3 decayPiecewise3(vec3 s, float dt) {
    return vec3(
        decayPiecewise(s.x, dt, PH_TAU_HI.x, PH_KNEE.x, PH_TAU_LO.x),
        decayPiecewise(s.y, dt, PH_TAU_HI.y, PH_KNEE.y, PH_TAU_LO.y),
        decayPiecewise(s.z, dt, PH_TAU_HI.z, PH_KNEE.z, PH_TAU_LO.z));
}

// NTSC-style hue rotation + saturation in YIQ space (linear input).
vec3 adjustChroma(vec3 c) {
#if CRT_MONO
    return c;
#else
    const mat3 toYIQ = mat3(
        0.299, 0.596, 0.211,
        0.587, -0.274, -0.523,
        0.114, -0.322, 0.312);
    const mat3 fromYIQ = mat3(
        1.0, 1.0, 1.0,
        0.956, -0.272, -1.106,
        0.621, -0.647, 1.703);
    vec3 yiq = toYIQ * c;
    float a = radians(CRT_TINT);
    float ca = cos(a), sa = sin(a);
    yiq.yz = mat2(ca, -sa, sa, ca) * yiq.yz * CRT_SATURATION;
    return fromYIQ * yiq;
#endif
}

// Fetch terminal content in linear light, un-premultiplied. Ghostty's
// terminal texture is premultiplied by the background-opacity alpha; a
// tube is opaque, so we recover the un-premultiplied color.
vec3 fetchContent(vec2 uv) {
    vec4 t = _CRT_CH0(uv);
#ifdef HOST_RETROARCH
    // Emulator frames arrive gamma-encoded; the physics runs in
    // linear light (Ghostty's sRGB sampler did this for us).
    return pow(max(t.rgb, 0.0), vec3(2.2));
#else
    return t.rgb / max(t.a, 1e-3);
#endif
}

// Average picture level: sparse 4x4 grid of the terminal content.
// Feeds the ABL (beam limiter) and pass 2's HV breathing/blooming.
float measureAPL() {
    float apl = 0.0;
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            vec2 uv = (vec2(float(x), float(y)) + 0.5) / 4.0;
            apl += dot(fetchContent(uv), LUMA);
        }
    }
    return apl / 16.0;
}

// ---------------------------------------------------------------------------
// Signal chain: sRGB-domain video controls, then the gun's transfer curve.
// The terminal texture arrives linearized by the GL sRGB sampler; we go
// back to signal (voltage) domain because that is where CONTRAST and
// BRIGHTNESS pots physically operate, then apply the gun gamma to get
// beam power. Gun gamma is expressed relative to the 2.2 the content
// was authored for.
// ---------------------------------------------------------------------------
vec3 signalToDrive(vec3 linearContent) {
    vec3 signal = pow(max(linearContent, 0.0), vec3(1.0 / 2.2));
    signal = signal * CRT_CONTRAST + CRT_BRIGHTNESS;
    signal = clamp(signal, 0.0, 1.4); // amp clips eventually
    return pow(signal, vec3(CRT_TUBE_GAMMA));
}

#if CRT_VECTOR_MODE != 0
// ---------------------------------------------------------------------------
// Vector / XY beam extraction (pass 1). A vector monitor has no line raster:
// the beam is steered directly in XY and writes phosphor strokes. Since we
// receive a rasterised terminal frame, the "beam path" is recovered from the
// content here, in unwarped content space (warp is a pass-2 sampling concern,
// exactly like the DVST traces). Two honest extraction modes:
//   outline (1): Sobel edge magnitude of the luma field. Robust for any font,
//                but a thick stem shows as two parallel strokes and a filled
//                block becomes an outlined rectangle (a vector tube cannot
//                fill — this is what a raster->display-list converter does).
//   stroke  (2): thresholded luma (+ a light 3x3 max to bridge AA). Correct
//                only for hairline glyphs where the raster already IS the beam
//                path; endpoint dwell dots then land at real stroke ends.
// ---------------------------------------------------------------------------
float vecLuma(vec2 uv) {
    return dot(fetchContent(uv), LUMA);
}

// Beam mask in [0,1]: how strongly the beam is "on" at this texel.
float vecBeamMask(vec2 uv, vec2 res) {
    vec2 px = 1.0 / res;
#if CRT_VECTOR_MODE == 1
    float l00 = vecLuma(uv + px * vec2(-1.0, -1.0));
    float l10 = vecLuma(uv + px * vec2( 0.0, -1.0));
    float l20 = vecLuma(uv + px * vec2( 1.0, -1.0));
    float l01 = vecLuma(uv + px * vec2(-1.0,  0.0));
    float l21 = vecLuma(uv + px * vec2( 1.0,  0.0));
    float l02 = vecLuma(uv + px * vec2(-1.0,  1.0));
    float l12 = vecLuma(uv + px * vec2( 0.0,  1.0));
    float l22 = vecLuma(uv + px * vec2( 1.0,  1.0));
    float gx = (l20 + 2.0 * l21 + l22) - (l00 + 2.0 * l01 + l02);
    float gy = (l02 + 2.0 * l12 + l22) - (l00 + 2.0 * l10 + l20);
    float mag = sqrt(gx * gx + gy * gy);
    return smoothstep(CRT_VECTOR_EDGE_THRESHOLD,
                      CRT_VECTOR_EDGE_THRESHOLD * 2.0 + 0.03, mag);
#else
    float m = vecLuma(uv);
    m = max(m, max(max(vecLuma(uv + vec2(px.x, 0.0)),
                       vecLuma(uv - vec2(px.x, 0.0))),
                   max(vecLuma(uv + vec2(0.0, px.y)),
                       vecLuma(uv - vec2(0.0, px.y)))));
    return smoothstep(CRT_VECTOR_EDGE_THRESHOLD,
                      CRT_VECTOR_EDGE_THRESHOLD + 0.06, m);
#endif
}

// Endpoint/corner dwell: a lit centre with FEW lit ring arms is a stroke
// terminal (1 arm) or corner (2 adjacent arms) where the beam dwells and
// burns brighter; a mid-stroke texel has more lit arms. Dwell rises as the
// lit-arm count falls (MAME's beam_dot_size / the DVG's dwell dots, done
// physically). Meaningful where strokes are single lines.
float vecDwell(vec2 uv, vec2 res, float centerMask) {
    if (centerMask < 0.25) return 0.0;
    vec2 px = 1.0 / res;
    float lit = 0.0;
    for (int i = 0; i < 8; i++) {
        float a = float(i) * 0.78539816; // 2*pi/8
        vec2 s = uv + vec2(cos(a), sin(a)) * 1.8 * px;
        lit += step(CRT_VECTOR_EDGE_THRESHOLD, vecLuma(s));
    }
    return centerMask * smoothstep(3.5, 1.0, lit);
}

// Vector APL slot = stroke density: average "beam on" over a sparse grid.
// On a real vector tube the average beam current IS the display-list length,
// which drives ABL, HV breathing, and the refresh-vs-load flicker beat. Cheap
// luma-threshold (not per-sample Sobel) keeps this off the hot path.
float measureVectorDensity() {
    float d = 0.0;
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            vec2 uv = (vec2(float(x), float(y)) + 0.5) / 4.0;
            d += step(CRT_VECTOR_EDGE_THRESHOLD, vecLuma(uv));
        }
    }
    return d / 16.0;
}
#endif // CRT_VECTOR_MODE

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 res = iResolution.xy;
    vec2 uv = fragCoord / res;
    float dt = clamp(iTimeDelta, 0.0, DT_MAX);

    // Previous state (self-feedback; zeroed on first frame / resize).
    vec4 histP0 = _CRT_CH1(vec2(0.5, 0.5) / res);
    vec4 histP1 = _CRT_CH1(vec2(1.5, 0.5) / res);
    bool initialized = histP1.a > 0.5;

    // ---------------- state machine (recomputed for every pixel, ------
    // ---------------- written only into the data row) -----------------
    float seqClock = histP0.r + dt;
    float storedPowerNonce = histP0.g;
    float storedDegaussNonce = histP0.b;
    float powerState = histP0.a;
    float warmClock = histP1.r;
    float aplIIR = histP1.g;
    float degaussClock = histP1.b + dt;

    bool powerOn = CRT_POWER_ON != 0;

    if (!initialized) {
        // First frame after shader load / resize: treat as a power event
        // so a fresh Ghostty plays the era-correct warmup. (A real CRT
        // blanks and resyncs on a mode change too.)
        seqClock = 0.0;
        warmClock = 0.0;
        degaussClock = 1000.0;
        storedPowerNonce = float(CRT_POWER_NONCE);
        storedDegaussNonce = float(CRT_DEGAUSS_NONCE);
        powerState = powerOn ? 1.0 : 0.0;
    } else {
        if (storedPowerNonce != float(CRT_POWER_NONCE)) {
            // Panel power button: restart the sequence clock for the
            // on- or off-sequence.
            seqClock = 0.0;
            storedPowerNonce = float(CRT_POWER_NONCE);
            powerState = powerOn ? 1.0 : 0.0;
        }
        if (storedDegaussNonce != float(CRT_DEGAUSS_NONCE)) {
            degaussClock = 0.0;
            storedDegaussNonce = float(CRT_DEGAUSS_NONCE);
        }
    }

    // Cathode thermal state: heats while powered, cools ~3x faster off.
    warmClock = powerOn
        ? min(warmClock + dt, 3600.0)
        : max(warmClock - 3.0 * dt, 0.0);

    // APL integrator (ABL sense line, tau ~120 ms). In vector mode the same
    // sense line measures STROKE DENSITY instead of picture level (average
    // beam current == display-list length on a vector tube).
#if CRT_VECTOR_MODE != 0
    float aplNow = measureVectorDensity();
#else
    float aplNow = measureAPL();
#endif
    aplIIR = initialized
        ? mix(aplNow, aplIIR, exp(-dt / 0.12))
        : aplNow;

#if CRT_DVST
    // ---------------- DVST erase state machine (data pixel P2) --------
    vec4 histP2 = _CRT_CH1(vec2(2.5, 0.5) / res);
    float eraseClock = histP2.r + dt;
    float storedEraseNonce = histP2.g;
    float mismatchIIR = histP2.b;
    if (!initialized) {
        eraseClock = 1000.0;
        storedEraseNonce = float(CRT_ERASE_NONCE);
        mismatchIIR = 0.0;
    } else if (storedEraseNonce != float(CRT_ERASE_NONCE)) {
        eraseClock = 0.0;                     // ERASE button: page flash
        storedEraseNonce = float(CRT_ERASE_NONCE);
    }
  #if CRT_DVST_AUTO_ERASE
    // Host-style page erase: when most sampled stored points no longer
    // have live content under them (scroll/clear), fire the flash. The
    // mismatch metric itself is computed only in the data-pixel branch
    // below; every pixel reads the shared IIR from P2 so the decision
    // is uniform across the frame.
    if (eraseClock > 1.2 && mismatchIIR > 0.35) {
        eraseClock = 0.0;
    }
  #endif

    // ---------------- progressive writing-beam clock (data pixel P5) ---
    // Time since the current draw pass was allowed to begin. The beam is
    // steered point-to-point, so a page is laid down over T_draw seconds
    // (scaled by ink coverage), not flashed on at once. Reset to 0 on
    // power-on / fresh load and on every erase (button, auto, or nonce);
    // held at 0 through the erase flash + lockout; advances by wall time
    // once the beam may store again. Deterministic in every pixel (reads
    // its own previous value from P5.r), so content pixels and the data
    // fragment agree without a second texture fetch of the front.
    vec4 histP5 = _CRT_CH1(vec2(5.5, 0.5) / res);
    float writeClock = histP5.r;
    float inkCoverage = histP2.a;              // 1-frame-lagged ink fraction (P2.a)
    bool dvstPowerEvent = initialized && histP0.g != float(CRT_POWER_NONCE);
    if (!initialized || dvstPowerEvent) {
        writeClock = 0.0;
    } else if (eraseClock < DVST_ERASE_LOCK_T) {
        writeClock = 0.0;                      // flash + collapse + lockout
    } else {
        writeClock += dt;
    }

    // Total sweep duration stretches with how full the page is, and the
    // WRITE SPEED knob scales the whole thing (>1 faster, <1 slower). Raw
    // ink fraction -> page fullness against the full-page reference above.
    float dvstFullness = clamp(inkCoverage / DVST_WRITE_FULL_COV, 0.0, 1.0);
    float dvstDrawT = (DVST_WRITE_BASE_T + DVST_WRITE_FULL_T * dvstFullness)
                      / max(CRT_DVST_WRITE_RATE, 0.01);
    // Beam front in scan-order space [0 .. 1+LR_WEIGHT]. >= ordMax => the
    // sweep is finished (or the page was empty): latch becomes immediate,
    // so ordinary typing draws where you type, as a real DVST does.
    float dvstOrdMax = 1.0 + DVST_WRITE_LR_WEIGHT;
    float dvstFront = (writeClock / max(dvstDrawT, 1e-3)) * dvstOrdMax;
#endif

#define CRT_TEMPORAL_CLOCK ((CRT_ROLLING_SCAN != 0 || CRT_INTERLACE) && !CRT_DVST && !CRT_PDP)

#if CRT_TEMPORAL_CLOCK
    // ---------------- vertical-scan clock (data pixel P4) -------------
    // Measure the actual display refresh (IIR of 1/dt) and advance the
    // raster phase at the configured FIELD RATE by wall-clock time. The
    // field parity flips on every phase wrap — this is the interlace
    // field clock (59.94 fields/s = two fields per 29.97fps NTSC frame).
    // Rolling scan engages at >=110Hz measured refresh; temporal
    // interlace engages whenever refresh >= the field rate itself.
    vec4 histP4 = _CRT_CH1(vec2(4.5, 0.5) / res);
    float rollPhase = fract(histP4.r + dt * CRT_SCAN_RATE);
    float estHz = histP4.g;
    float hzNow = 1.0 / max(dt, 1e-4);
    estHz = (estHz < 1.0) ? hzNow : mix(hzNow, estHz, exp(-dt / 0.5));
    float rollPrev = histP4.r;
    float fieldParity = histP4.b;
    if (rollPhase < rollPrev) fieldParity = 1.0 - fieldParity;
#else
    float rollPhase = 0.0;
    float rollPrev = 0.0;
    float estHz = 60.0;
    float fieldParity = 0.0;
#endif

    // ---------------- data row output ----------------
    if (fragCoord.y < 1.0) {
        float x = floor(fragCoord.x);
        if (x < 1.0) {
            fragColor = vec4(seqClock, storedPowerNonce, storedDegaussNonce,
                             powerState);
        } else if (x < 2.0) {
            fragColor = vec4(warmClock, aplIIR, degaussClock, 1.0);
#if CRT_TEMPORAL_CLOCK
        } else if (x < 5.0 && x >= 4.0) {
            fragColor = vec4(rollPhase, estHz, fieldParity, 0.0);
#endif
#if CRT_SMOOTH_SCROLL
        } else if (x >= 3.0 && x < 4.0) {
            // DECSCLM scroll detector (data pixel P3). Correlate current
            // content against the feedback history at shifts of 0, ±1,
            // ±2 cell heights; a decisive non-zero winner means the
            // terminal scrolled and the offset is queued for the display
            // pass to glide through (VT100 queued linefeeds the same way).
            vec4 histP3 = _CRT_CH1(vec2(3.5, 0.5) / res);
            float offsetPx = histP3.r;

            // Ease the queued offset out at the documented rate:
            // 1 scan line/frame = 6 text lines/s => 6 cells/s in pixels.
            float glide = 6.0 * float(CRT_SMOOTH_CELL_PX) * dt;
            offsetPx -= sign(offsetPx) * min(abs(offsetPx), glide);

            float cellPx = float(CRT_SMOOTH_CELL_PX);
            float best = 1e9;
            float bestShift = 0.0;
            float sad0 = 0.0;
            for (int c = -2; c <= 2; c++) {
                float shiftPx = float(c) * cellPx;
                float sad = 0.0;
                for (int i = 0; i < 12; i++) {
                    // Sample mid-screen rows; avoid top/bottom status rows.
                    vec2 sp = vec2(
                        (fract(float(i) * 0.618) * 0.8 + 0.1),
                        0.18 + 0.55 * float(i) / 11.0);
                    float nowL = dot(fetchContent(sp), LUMA);
                    vec2 hp = sp + vec2(0.0, shiftPx / res.y);
                    hp.y = clamp(hp.y, 2.5 / res.y, 1.0);
                    float prevL = dot(_CRT_CH1(hp).rgb, LUMA);
                    sad += abs(nowL - prevL);
                }
                if (c == 0) sad0 = sad;
                if (sad < best) { best = sad; bestShift = shiftPx; }
            }
            // Decisive winner only: guards against typing/noise. Content
            // moved up => sample matches history BELOW => positive shift.
            if (bestShift != 0.0 && best < 0.55 * sad0 && sad0 > 0.4) {
                offsetPx = clamp(offsetPx + bestShift,
                                 -4.0 * cellPx, 4.0 * cellPx);
            }
            fragColor = vec4(offsetPx, 0.0, 0.0, 0.0);
#endif
#if !CRT_DVST
        } else if (x < 3.0 && x >= 2.0) {
            // Non-storage tubes: the ERASE nonce means "tube swap" —
            // an instant excitation clear (crtctl swap-style fresh /
            // crtctl erase). P2.r stores the latest nonce; content
            // pixels clear on the one frame where their history's
            // stored copy differs from the compiled value.
            fragColor = vec4(float(CRT_ERASE_NONCE), 0.0, 0.0, 0.0);
#endif
#if CRT_SMOOTH_SCROLL && !CRT_DVST
        } else if (x < 4.0 && x >= 3.0) {
            // -------- DECSCLM smooth-scroll detector (data pixel P3) ----
            // Correlate current content against the previous frame's
            // excitation at multiples of the cell height. On a detected
            // whole-cell shift, queue glide distance; the display pass
            // consumes it at the documented 1-scan-line-per-frame rate
            // (6 text lines/second, EK-VT100-TM 4.7.8).
            vec4 histP3 = _CRT_CH1(vec2(3.5, 0.5) / res);
            float off = histP3.r;
            float cellH = float(CRT_SMOOTH_CELL_PX);
            float glideRate = 6.0 * cellH; // px/s
            off -= sign(off) * min(abs(off), glideRate * dt);

            bool scrollDetectOK = initialized && powerOn;
#if CRT_ROLLING_SCAN != 0
            // Under an active rolling scan the feedback history holds a
            // band-decayed image, not last frame's picture — correlation
            // against it would misfire. The two features target different
            // hardware (60Hz terminals vs >=120Hz motion clarity).
            scrollDetectOK = scrollDetectOK && estHz < 110.0;
#endif
            if (scrollDetectOK) {
                float bestSAD = 1e9;
                float sad0 = 0.0;
                float bestS = 0.0;
                for (int c = -2; c <= 2; c++) {
                    float s = float(c) * cellH;
                    float sad = 0.0;
                    for (int i = 0; i < 12; i++) {
                        vec2 pt = vec2(
                            fract(float(i) * 0.618) * 0.8 + 0.1,
                            0.20 + 0.55 * float(i) / 11.0);
                        vec3 nowDrive = signalToDrive(
                            adjustChroma(fetchContent(pt)));
                        float nowL = dot(nowDrive, LUMA);
                        vec2 hp = pt + vec2(0.0, s / res.y);
                        hp.y = clamp(hp.y, 2.5 / res.y, 1.0);
                        vec3 prevE = _CRT_CH1(hp).rgb;
#if CRT_MONO
                        float prevL = prevE.r;
#else
                        float prevL = dot(prevE, LUMA);
#endif
                        sad += abs(nowL - prevL);
                    }
                    if (c == 0) sad0 = sad;
                    if (sad < bestSAD) { bestSAD = sad; bestS = s; }
                }
                // Confident non-zero winner = the content jumped by
                // bestS px this frame. Queue the glide (VT100s queued
                // line feeds; motion is constant-velocity, never eased).
                if (bestS != 0.0 && sad0 > 0.4 && bestSAD < 0.5 * sad0) {
                    off += -bestS;
                    off = clamp(off, -4.0 * cellH, 4.0 * cellH);
                }
            }
            fragColor = vec4(off, 0.0, 0.0, 0.0);
#endif
#if CRT_DVST
        } else if (x < 3.0) {
            // Stored-vs-live mismatch probe: of the sampled points that
            // are STORED, what fraction has no live terminal content
            // anymore? Glyph ink is sparse — a full page of text lights
            // only ~5-15% of texels — so single-texel probes hit strokes
            // rarely; a probe set must be LARGE and must not align with
            // the text-cell grid. (A 4x4 axis-aligned grid averaged one
            // stored hit on a full page, which kept the >=4-hit floor
            // below permanently unmet: auto-erase could never fire.)
            // 256 R2 low-discrepancy points cover the screen uniformly
            // at every scale with no cell-pitch aliasing, and this runs
            // for the single P2 data fragment only.
            float storedCnt = 0.0;
            float deadCnt = 0.0;
            float inkCnt = 0.0;
            for (int i = 0; i < 256; i++) {
                vec2 guv = fract(vec2(0.754877666, 0.569840291) * float(i)
                                 + 0.5);
                guv.y = max(guv.y, 2.5 / res.y);
                float raw = dot(fetchContent(guv), LUMA);
                if (raw >= 0.08) inkCnt += 1.0;   // live ink fraction (all probes)
                float st = _CRT_CH1(guv).r;
                if (st > 0.5) {
                    storedCnt += 1.0;
                    if (raw < 0.08) deadCnt += 1.0;
                }
            }
            // >=4 stored hits (roughly two lines of latched text) before
            // the dead fraction means anything; below that there is no
            // page worth flashing away.
            float mismatch = storedCnt > 3.5 ? deadCnt / storedCnt : 0.0;
            float mm = initialized
                ? mix(mismatch, mismatchIIR, exp(-dt / 0.08))
                : 0.0;
            // P2.a = live ink coverage (fraction of screen with content):
            // drives how long the progressive write takes (more content ->
            // longer draw). Same 256-probe set; free to piggyback here.
            float inkCov = inkCnt / 256.0;
            fragColor = vec4(eraseClock, storedEraseNonce, mm, inkCov);
        } else if (x < 6.0) {
            // P5: progressive writing-beam clock (seconds since the draw
            // pass began). Content pixels read this and the coverage in
            // P2.a to place the beam front; nothing else stores it.
            fragColor = vec4(writeClock, 0.0, 0.0, 0.0);
#endif
        } else {
            fragColor = vec4(0.0);
        }
        return;
    }

    // ---------------- content pixels ----------------
    vec3 content = fetchContent(uv);
    content = adjustChroma(content);
    vec3 drive = signalToDrive(content);

    // Automatic beam limiter: compress drive when the average picture
    // level exceeds the threshold (a full-white screen dims; sparse
    // bright text on black does not).
    float ablComp = 1.0 / (1.0 + CRT_ABL * max(aplIIR - 0.35, 0.0) * 2.2);
    drive *= ablComp;

    // Beam only excites phosphor when powered and past the HV-up point;
    // the visible on/off choreography (dot/line/raster) is pass 2's job,
    // but the excitation source itself must honor power.
    float beamOn = powerOn ? 1.0 : 0.0;
    drive *= beamOn;

#if CRT_ROLLING_SCAN != 0 && !CRT_DVST && !CRT_PDP && CRT_VECTOR_MODE == 0
    // ---------------- rolling-scan beam injection ----------------------
    // Only the rows the beam crossed since the previous panel frame get
    // fresh excitation; everything else rides its (measured) phosphor
    // decay. This is the temporal half of a CRT — the part that needs
    // panel refresh >= 2x the 60Hz content rate to exist at all.
    //
    // The sweep runs top-to-bottom like the raster. Band width equals
    // the fraction of the 60Hz cycle this panel frame spans, so every
    // row is painted exactly once per cycle regardless of refresh; at
    // 60Hz the band is the whole screen (exact no-op).
  #if CRT_ROLLING_SCAN == 1
    bool rollActive = estHz >= 110.0;
  #else
    bool rollActive = true; // force (testing on unverified hardware)
  #endif
    if (rollActive) {
        float w = clamp(dt * CRT_SCAN_RATE, 0.0, 1.0); // swept fraction this frame
        if (w < 0.999) {
            float rowPhase = 1.0 - uv.y;         // top row scans first
            // Distance of this row behind the current beam position,
            // wrapped into [0,1): rows within w were struck this frame.
            float behind = fract(rollPhase - rowPhase);
            float soft = max(w * 0.25, 1.5 / res.y);
            float band = smoothstep(w + soft, w - soft, behind)
                       // include the wrap so behind==0 (beam row) is lit
                       + smoothstep(soft, 0.0, behind) * step(w + soft, behind);
            band = clamp(band, 0.0, 1.0);
            // Talbot-Plateau compensation: duty-cycle dimming traded
            // against overdrive (capped 3x — SDR has no phosphor to
            // punch through the ceiling with).
            float comp = mix(1.0, min(1.0 / max(w, 1e-3), 3.0),
                             CRT_ROLLING_GAIN);
            drive *= band * comp;
        }
    }
#endif

#if CRT_INTERLACE && !CRT_DVST && !CRT_PDP && CRT_VECTOR_MODE == 0
    // ---------------- true temporal interlace --------------------------
    // When the panel's measured refresh reaches the field rate, each
    // panel frame carries ONE real field: the beam injects only the
    // current field's comb of lines (odd fields land between the even
    // field's lines — the comb on the full line grid does exactly
    // that). Twitter, pairing, and per-line low-rate flicker emerge
    // from the phosphor decay between field visits. The 1.5x gain
    // partially repays the halved line duty (real tubes paid the rest
    // in per-line flicker, and so do we).
    if (estHz >= CRT_SCAN_RATE * 0.95) {
        float lineIdx = floor(uv.y * float(CRT_SCAN_LINES));
        float lineParity = mod(lineIdx, 2.0);
        float onField = 1.0 - step(0.5, abs(lineParity - fieldParity));
        drive *= onField * 1.5;
    }
#endif

#if CRT_VECTOR_MODE != 0
    // ---------------- vector beam extraction ---------------------------
    // Replace the raster drive with the beam path pulled from content. The
    // content luminance stays in `drive`, so per-stroke intensity levels
    // (dim comments, bright bold) come for free — the DVG's 16 levels as an
    // emergent property. Endpoint/corner dwell is measured for the G slot.
    float vMask = vecBeamMask(uv, res);
    float vDwell = vecDwell(uv, res, vMask);
    drive *= vMask;
    if (CRT_VECTOR_GRAIN > 0.0 && vMask > 0.01) {
        // Per-stroke grain: deflection-amp noise / beam-current ripple / DAC
        // quantisation rides only the lit strokes (the frame-wide snow is the
        // NOISE knob's job, applied in pass 2).
        float g = hash12(fragCoord + vec2(fract(iTime * 41.0) * 613.0, 7.0));
        drive *= 1.0 + CRT_VECTOR_GRAIN * (g - 0.5);
    }
#endif

#if CRT_MONO
    // Monochrome: one continuous phosphor. R slot carries excitation.
    float mdrive = dot(drive, LUMA);
    drive = vec3(mdrive, 0.0, 0.0);
#endif

#if CRT_DVST
    // ------------------------------------------------------------------
    // BISTABLE STORAGE (Tektronix DVST). Channel layout:
    //   R = stored latch (0 or 1; 1.1 during the erase flash)
    //   G = writing-flash energy (keV cathodoluminescence, settles to
    //       stored level with tau ~180 ms)
    //   B = write-through level (the refreshed, non-stored cursor)
    //   A = burn-in dose (storage tubes burned badly on held pages)
    // Nothing except the erase sequence ever lowers R: deleted text
    // keeps glowing. That is the tube working correctly.
    // ------------------------------------------------------------------
    vec4 histD = _CRT_CH1(uv);
    float stored = histD.r;
    float flash = histD.g * exp(-dt / DVST_FLASH_TAU);
    float wthru = 0.0;
    float drvL = drive.r; // mono luma drive (beamOn already applied)

    // The cursor is the terminal's one refreshed (non-stored) object:
    // exclude its cell from latching or it would store a trail of
    // block ghosts everywhere it has ever been.
    bool inCursor = false;
    if (iCurrentCursorColor.a > 0.0) {
        vec2 cpos = iCurrentCursor.xy;
        vec2 csz = iCurrentCursor.zw;
        inCursor = fragCoord.x >= cpos.x - 1.0 &&
                   fragCoord.x <= cpos.x + csz.x + 1.0 &&
                   fragCoord.y <= cpos.y + 1.0 &&
                   fragCoord.y >= cpos.y - csz.y - 1.0;
    }

    if (eraseClock < DVST_ERASE_FLASH_T) {
        // Fade-positive pulse: the flood guns write the ENTIRE screen.
        stored = 1.1;
        flash = 0.0;
    } else if (eraseClock < DVST_ERASE_FALL_T) {
        // Backplate slammed to 0 V: light collapses in tens of ms.
        stored *= exp(-dt / 0.045);
        flash = 0.0;
    } else if (eraseClock < DVST_ERASE_LOCK_T) {
        // Recovery: dark, and nothing can store yet.
        stored = 0.0;
        flash = 0.0;
    } else {
        // Progressive write: the steered beam has only reached content
        // whose scan-order position is at or behind the advancing front.
        // Order is a top-to-bottom sweep with a slight left->right tilt
        // (reading/writing order) — a rasterised terminal frame carries no
        // true vector draw order, so this is a defensible approximation of
        // it (see DESIGN.md honest approximations). Once the front passes
        // ordMax the initial page is fully drawn and latch becomes
        // immediate, so ordinary typing draws instantly where the cursor
        // is, exactly as a real DVST redraws only the new stroke.
        float dvstOrd = (1.0 - uv.y) + uv.x * DVST_WRITE_LR_WEIGHT;
        bool reached = dvstFront >= dvstOrd;
        if (!inCursor && drvL >= DVST_STORE_THRESHOLD && stored < 0.5 && reached) {
            // Fresh write: latch, with the bright whiter writing flash.
            // The flash left behind the moving front IS the writing spot
            // (settles to the stored level with DVST_FLASH_TAU), so the
            // beam is visibly seen sweeping the page into existence.
            stored = 1.0;
            flash = 1.0;
        }
        // Stored content: no decay. Ever.
    }

    if (inCursor && drvL > 0.15) {
        // Write-through: visible but below storage threshold.
        wthru = DVST_WTHRU_LEVEL;
    }

    // Burn-in: a held page keeps its dose integrating forever — the
    // classic ghost-menu fate of storage tubes.
    float doseD = histD.a;
    float incD = (stored * 0.5 + flash * 0.5) * dt * 9.7e-5 * CRT_BURNIN_RATE;
    if (incD > 0.0) {
        const float qD = 5e-4;
        float rD = hash12(fragCoord + vec2(fract(iTime) * 917.0, 0.0));
        doseD += qD * step(rD, incD / qD);
        doseD = min(doseD, 1.0);
    }

    fragColor = vec4(stored, flash, wthru, doseD);
    return;
#endif

    // Cursor strike overdrive: freshly hit phosphor flashes above its
    // settled level (beam dwell + rise), decaying within ~100 ms.
    if (CRT_CURSOR_OVERDRIVE > 0.0 && iCurrentCursorColor.a > 0.0) {
        float age = iTime - iTimeCursorChange;
        if (age >= 0.0 && age < 0.25) {
            // iCurrentCursor: xy = top-left origin corner, zw = size,
            // in pixels, same y-up space as fragCoord on OpenGL.
            vec2 cpos = iCurrentCursor.xy;
            vec2 csz = iCurrentCursor.zw;
            // Rect test with y measured downward from the corner:
            bool inX = fragCoord.x >= cpos.x && fragCoord.x <= cpos.x + csz.x;
            bool inY = fragCoord.y <= cpos.y && fragCoord.y >= cpos.y - csz.y;
            if (inX && inY) {
                drive *= 1.0 + CRT_CURSOR_OVERDRIVE * exp(-age / 0.04);
            }
        }
    }

    // Phosphor excitation: new beam energy vs decayed previous state.
    vec4 hist = _CRT_CH1(uv);
    vec3 excited = decayPiecewise3(hist.rgb, dt);

#if !CRT_DVST
    // Tube swap (ERASE nonce changed): this frame, the old tube's glow
    // is gone — fresh phosphor, no ghosts. Preset switches use this
    // when crtctl swap-style is 'fresh'; 'carry' keeps the organic
    // cross-preset ghosting (real persistence, reinterpreted by the
    // new tube's chemistry — the "glitch" made official).
    {
        vec4 histP2n = _CRT_CH1(vec2(2.5, 0.5) / res);
        if (initialized && histP2n.r != float(CRT_ERASE_NONCE)) {
            excited = vec3(0.0);
        }
    }
#endif

#if CRT_PDP
    // Dynamic false contouring: motion-gated per-channel posterization
    // with overshoot near the MSB bit-boundary codes — the integrated-
    // subfield solarization bands of a moving gradient. (Cheap-recipe
    // approximation of true bit-plane displacement; see DESIGN.md.)
    if (CRT_PDP_CONTOUR > 0.0) {
        float motion = smoothstep(0.02, 0.12,
            abs(dot(drive, LUMA) - dot(hist.rgb, LUMA)));
        if (motion > 0.001) {
            vec3 v255 = clamp(drive, 0.0, 1.0) * 255.0;
            vec3 msbDist = min(min(abs(v255 - 32.0), abs(v255 - 64.0)),
                               min(abs(v255 - 128.0), abs(v255 - 192.0)));
            vec3 nearMSB = 1.0 - smoothstep(4.0, 9.0, msbDist);
            vec3 post = floor(drive * 24.0 + 0.5) / 24.0;
            vec3 band = post + (post - drive) * 1.8;
            drive = mix(drive, band, nearMSB * motion * CRT_PDP_CONTOUR);
        }
    }
#endif

#if CRT_VECTOR_MODE != 0
  #if CRT_MONO
    // Mono vector (P4 Asteroids/Vectrex, P31 scope): R = stroke excitation
    // through the existing decay engine; G = endpoint/corner dwell held with
    // a slightly longer effective decay so the dwell dots linger a touch past
    // the strokes; B unused.
    float vR = max(drive.r, excited.r);
    float gDecay = PH_TAU_LO.x * 2.5 * max(CRT_PERSISTENCE, 1e-3);
    float vG = max(vDwell, hist.g * exp(-dt / max(gDecay, 1e-4)));
    vec3 newState = vec3(vR, vG, 0.0);
  #else
    // Colour vector (P22 shadow-mask tube — Tempest/Star Wars): RGB carry
    // colour, so there is no free dwell channel; endpoint brightness still
    // emerges from the beam-mask modulation.
    vec3 newState = max(drive, excited);
  #endif
#elif CRT_P7_CASCADE
    // P7: R = blue flash layer (direct beam), G = yellow layer pumped by
    // the blue layer's LIGHT (not the beam) — hence the visible lag.
    float blue = max(drive.r, excited.r);
    float yPrev = hist.g * exp(-dt / (PH_TAU_LO.y * max(CRT_PERSISTENCE, 1e-3)));
    float yTarget = blue * 0.85;
    float yellow = mix(yPrev, max(yTarget, yPrev), 1.0 - exp(-dt / P7_RISE_TAU));
    vec3 newState = vec3(blue, yellow, 0.0);
#else
    vec3 newState = max(drive, excited);
#endif

    // ---------------- burn-in dose (Coulomb aging) ----------------
    float dose = hist.a;
#if CRT_MONO
    float emitLum = newState.r;
#else
    float emitLum = dot(newState, LUMA);
#endif
    // rate 1.0 => a static full-white region reaches dose ~0.35 in about
    // an hour (time-compressed physics; the dose->efficiency law is the
    // real one). Stochastic rounding keeps tiny increments alive in the
    // half-float accumulator instead of vanishing below its epsilon.
    float inc = emitLum * dt * 9.7e-5 * CRT_BURNIN_RATE;
    if (inc > 0.0) {
        const float q = 5e-4;
        float p = inc / q;
        float r = hash12(fragCoord + vec2(fract(iTime) * 917.0, 0.0));
        dose += q * step(r, p);
        dose = min(dose, 1.0);
    }

    fragColor = vec4(newState, dose);
}

void main()
{
    vec2 _fc = vec2(vTexCoord.x, 1.0 - vTexCoord.y)
             * params.OutputSize.xy;
    mainImage(FragColor, _fc);
    // Pass 0 must ALSO linearize its content input: Ghostty
    // sampled an sRGB texture (auto-linearized); RetroArch
    // hands us raw encoded values. Handled inside
    // fetchContent via HOST_RETROARCH.
}
