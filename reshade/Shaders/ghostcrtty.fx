// ghostcrtty whole-screen CRT for ReShade and gamescope.
// Generated by transpile_reshade.py. Re-run the generator after schema edits.

// Self-contained on purpose: vkBasalt ships no ReShade headers, so the one
// thing we used from ReShade.fxh — the fullscreen-triangle vertex shader —
// is inlined here (same implementation; Windows ReShade accepts
// header-free effects). BUFFER_* macros are injected by every host.
void PostProcessVS(in uint id : SV_VertexID,
                   out float4 position : SV_Position,
                   out float2 texcoord : TEXCOORD)
{
    texcoord.x = (id == 2) ? 2.0 : 0.0;
    texcoord.y = (id == 1) ? 2.0 : 0.0;
    position = float4(texcoord * float2(2.0, -2.0) + float2(-1.0, 1.0),
                      0.0, 1.0);
}

uniform int Ghost_Phosphor <
    ui_type = "combo";
    ui_items = "P22 color\0P22 D93\0P1 scope\0P31 green\0P39 long green\0P3 amber\0P134 amber\0P4 white\0Paperwhite\0P7 radar\0P11 blue\0DVST-ish\0PDP-ish\0";
    ui_label = "Tube phosphor";
> = 0;
uniform int Ghost_MaskType <
    ui_type = "combo";
    ui_items = "none\0grille\0slot\0delta\0";
    ui_label = "Mask";
> = 1;
uniform int Ghost_Geometry <
    ui_type = "combo";
    ui_items = "flat\0cylindrical\0spherical\0";
    ui_label = "Geometry";
> = 1;

uniform float Ghost_Brightness < ui_label = "Brightness"; ui_min = -0.25; ui_max = 0.25; ui_step = 0.005; > = 0.0;
uniform float Ghost_Contrast < ui_label = "Contrast"; ui_min = 0.4; ui_max = 2.2; ui_step = 0.01; > = 1.0;
uniform float Ghost_Focus < ui_label = "Focus"; ui_min = 0.6; ui_max = 2.5; ui_step = 0.01; > = 1.0;
uniform float Ghost_CurveRadius < ui_label = "Face radius"; ui_min = 1.5; ui_max = 8.0; ui_step = 0.1; > = 4.0;
uniform float Ghost_CornerRadius < ui_label = "Corner"; ui_min = 0.0; ui_max = 0.09; ui_step = 0.002; > = 0.02;
uniform float Ghost_Bezel < ui_label = "Bezel shade"; ui_min = 0.0; ui_max = 1.0; ui_step = 0.01; > = 0.35;
uniform float Ghost_ScanLines < ui_label = "Raster lines"; ui_min = 120.0; ui_max = 1600.0; ui_step = 1.0; > = 480.0;
uniform float Ghost_SpotSize < ui_label = "Spot size"; ui_min = 0.2; ui_max = 0.8; ui_step = 0.005; > = 0.32;
uniform float Ghost_Bloom < ui_label = "Beam bloom"; ui_min = 0.0; ui_max = 1.0; ui_step = 0.01; > = 0.55;
uniform float Ghost_Bandwidth < ui_label = "Bandwidth"; ui_min = 180.0; ui_max = 1400.0; ui_step = 10.0; > = 420.0;
uniform float Ghost_MaskStrength < ui_label = "Mask depth"; ui_min = 0.0; ui_max = 1.0; ui_step = 0.01; > = 0.35;
uniform float Ghost_Persistence < ui_label = "Persistence"; ui_min = 0.0; ui_max = 8.0; ui_step = 0.05; > = 1.0;
uniform float Ghost_TrailTint < ui_label = "Tail tint"; ui_min = 0.0; ui_max = 1.0; ui_step = 0.01; > = 0.6;
uniform float Ghost_Halation < ui_label = "Halation"; ui_min = 0.0; ui_max = 0.25; ui_step = 0.005; > = 0.06;
uniform float Ghost_Diffusion < ui_label = "Glass glow"; ui_min = 0.0; ui_max = 0.3; ui_step = 0.005; > = 0.08;
uniform float Ghost_GlassTint < ui_label = "Glass"; ui_min = 0.25; ui_max = 1.0; ui_step = 0.01; > = 0.75;
uniform float Ghost_Noise < ui_label = "Snow"; ui_min = 0.0; ui_max = 0.1; ui_step = 0.002; > = 0.005;
uniform float Ghost_VectorTrace < ui_label = "Vector beam"; ui_min = 0.0; ui_max = 1.0; ui_step = 0.01; > = 0.0;
uniform float Ghost_RadarOverlay < ui_label = "PPI graticule"; ui_min = 0.0; ui_max = 1.0; ui_step = 0.01; > = 0.0;
uniform float Ghost_RadarSweep < ui_label = "PPI sweep"; ui_min = 0.0; ui_max = 1.0; ui_step = 0.01; > = 0.0;
uniform float Ghost_RadarSweepRate < ui_label = "Sweep RPM"; ui_min = 1.0; ui_max = 60.0; ui_step = 0.5; > = 12.0;
uniform float Ghost_FrameTime < source = "frametime"; hidden = true; >;
uniform float Ghost_Timer < source = "timer"; hidden = true; >;

texture2D Ghost_BackBuffer : COLOR;
texture2D Ghost_StateA { Width = BUFFER_WIDTH; Height = BUFFER_HEIGHT; Format = RGBA16F; };
texture2D Ghost_StateB { Width = BUFFER_WIDTH; Height = BUFFER_HEIGHT; Format = RGBA16F; };

sampler2D BackBufferSampler { Texture = Ghost_BackBuffer; };
sampler2D StateASampler { Texture = Ghost_StateA; };
sampler2D StateBSampler { Texture = Ghost_StateB; };

static const float3 LUMA = float3(0.299, 0.587, 0.114);
static const float PI = 3.14159265359;

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float3 phosphorTint(int ph)
{
    if (ph == 3) return float3(0.23, 1.00, 0.34);
    if (ph == 4) return float3(0.18, 0.95, 0.25);
    if (ph == 5 || ph == 6) return float3(1.00, 0.58, 0.14);
    if (ph == 7 || ph == 8) return float3(0.92, 0.95, 1.00);
    if (ph == 9) return float3(0.41, 0.585, 1.00);
    if (ph == 10) return float3(0.25, 0.45, 1.00);
    return float3(1.0, 1.0, 1.0);
}

float3 tauFor(int ph)
{
    if (ph == 3) return float3(0.0003, 0.025, 0.0);
    if (ph == 4) return float3(0.040, 1.20, 0.0);
    if (ph == 5) return float3(0.0056, 0.040, 0.0);
    if (ph == 6) return float3(0.006, 0.350, 0.0);
    if (ph == 7) return float3(0.0124, 0.080, 0.0);
    if (ph == 8) return float3(0.0004, 0.020, 0.0);
    if (ph == 9) return float3(0.00025, 8.0, 0.120);
    if (ph == 10) return float3(0.00015, 0.005, 0.0);
    return float3(0.001, 0.045 * (0.5 + Ghost_TrailTint), 0.012);
}

float decayOne(float s, float dt, float tauHi, float knee, float tauLo)
{
    if (s <= 0.0 || Ghost_Persistence <= 0.0) return 0.0;
    tauHi *= Ghost_Persistence;
    tauLo *= Ghost_Persistence;
    if (s > knee) {
        float tKnee = tauHi * log(max(s / knee, 1.0001));
        if (dt <= tKnee) return s * exp(-dt / tauHi);
        return knee * exp(-(dt - tKnee) / tauLo);
    }
    return s * exp(-dt / tauLo);
}

float3 srgbToLinear(float3 c)
{
    return pow(max(c, 0.0), 2.2);
}

float3 signalToDrive(float3 linearContent)
{
    float3 signal = pow(max(linearContent, 0.0), 1.0 / 2.2);
    signal = saturate(signal * Ghost_Contrast + Ghost_Brightness);
    return pow(signal, 2.4);
}

float4 UpdateStatePS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    float dt = min(Ghost_FrameTime * 0.001, 0.1);
    float4 hist = tex2D(StateBSampler, uv);
    float3 drive = signalToDrive(srgbToLinear(tex2D(BackBufferSampler, uv).rgb));
    float mono = dot(drive, LUMA);
    float3 tau = tauFor(Ghost_Phosphor);

    float3 decayed;
    if (Ghost_Phosphor == 9) {
        float blue = decayOne(hist.r, dt, tau.x, 0.10, 0.008);
        float targetYellow = max(hist.g, max(mono, blue));
        float yellow = lerp(hist.g, targetYellow, 1.0 - exp(-dt / max(tau.z, 1e-4)));
        yellow = max(yellow * exp(-dt / max(tau.y, 1e-4)), mono * 0.35);
        decayed = float3(max(blue, mono), yellow, 0.0);
    } else if (Ghost_Phosphor >= 2 && Ghost_Phosphor != 12) {
        decayed = float3(decayOne(hist.r, dt, tau.x, 0.10, tau.y), 0.0, 0.0);
        decayed.r = max(decayed.r, mono);
    } else {
        decayed.r = max(decayOne(hist.r, dt, 0.001, 0.10, tau.x), drive.r);
        decayed.g = max(decayOne(hist.g, dt, 0.0004, 0.10, tau.y), drive.g);
        decayed.b = max(decayOne(hist.b, dt, 0.0003, 0.08, tau.z), drive.b);
    }

    float dose = saturate(hist.a + dot(decayed, LUMA) * dt * 0.00012);
    return float4(decayed, dose);
}

float2 warpToTube(float2 uv)
{
    float2 p = uv * 2.0 - 1.0;
    if (Ghost_Geometry != 0) {
        float radius = max(Ghost_CurveRadius, 1.0);
        float spherical = Ghost_Geometry == 2 ? 1.0 : 0.0;
        float2 bend = float2(p.x * p.y * p.y, p.y * p.x * p.x * spherical) / radius;
        p += bend;
    }
    return p * 0.5 + 0.5;
}

float3 sampleVector(float2 uv)
{
    float2 px = float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);
    float sigma = max(Ghost_SpotSize * 1.8 * Ghost_Focus, 0.55);
    float3 acc = 0.0;
    float wsum = 0.0;
    [unroll] for (int y = -2; y <= 2; ++y) {
        [unroll] for (int x = -2; x <= 2; ++x) {
            float2 d = float2(x, y);
            float w = exp(-0.5 * dot(d, d) / (sigma * sigma));
            acc += tex2D(StateASampler, uv + d * px).rgb * w;
            wsum += w;
        }
    }
    return acc / max(wsum, 1e-4);
}

float3 sampleRaster(float2 uv)
{
    float lines = max(Ghost_ScanLines, 1.0);
    float srcY = uv.y * lines - 0.5;
    float y0 = floor(srcY);
    float aspect = BUFFER_WIDTH * BUFFER_RCP_HEIGHT;
    float sigmaX = max(BUFFER_WIDTH / (Ghost_Bandwidth * aspect) * 0.45 * Ghost_Focus, 0.28);
    float3 acc = 0.0;
    [unroll] for (int l = 0; l < 2; ++l) {
        float ly = y0 + l;
        float lineV = (ly + 0.5) / lines;
        float dy = srcY - ly;
        float lum = dot(tex2D(StateASampler, float2(uv.x, lineV)).rgb, LUMA);
        float sigma = Ghost_SpotSize * (1.0 + Ghost_Bloom * 1.4 * pow(saturate(lum), 0.62)) * Ghost_Focus;
        float wLine = exp(-0.5 * (dy / sigma) * (dy / sigma)) / (sigma * 2.5066283);
        float3 lineAcc = 0.0;
        float wsum = 0.0;
        [unroll] for (int i = -2; i <= 2; ++i) {
            float dx = i;
            float wx = exp(-0.5 * (dx / sigmaX) * (dx / sigmaX));
            lineAcc += tex2D(StateASampler, float2(uv.x + dx * BUFFER_RCP_WIDTH, lineV)).rgb * wx;
            wsum += wx;
        }
        acc += wLine * lineAcc / max(wsum, 1e-4);
    }
    return acc;
}

float linePulse(float d, float width)
{
    return exp(-0.5 * (d / width) * (d / width));
}

float angleDelta(float a, float b)
{
    return abs(atan2(sin(a - b), cos(a - b)));
}

float3 radarLight(float2 uv)
{
    if (Ghost_RadarOverlay <= 0.0 && Ghost_RadarSweep <= 0.0) return 0.0;
    float aspect = BUFFER_WIDTH * BUFFER_RCP_HEIGHT;
    float2 p = (uv * 2.0 - 1.0) * float2(aspect, 1.0);
    float r = length(p);
    float a = atan2(p.y, p.x);
    float edge = 1.0 - smoothstep(0.96, 1.02, r);
    float ring = 0.0;
    [unroll] for (int i = 1; i <= 4; ++i) ring = max(ring, linePulse(abs(r - i * 0.2), 0.003));
    float cross = max(linePulse(abs(p.x), 0.0025), linePulse(abs(p.y), 0.0025)) * smoothstep(0.98, 0.86, r);
    float tick = 0.0;
    [unroll] for (int t = 0; t < 12; ++t) {
        float ta = -PI + t * PI / 6.0;
        float radial = smoothstep(0.98, 0.92, r) * smoothstep(0.78, 0.88, r);
        tick = max(tick, linePulse(angleDelta(a, ta) * max(r, 0.1), 0.0035) * radial);
    }
    float grid = saturate(ring * 0.55 + cross * 0.35 + tick * 0.8) * Ghost_RadarOverlay * edge;
    float sweepA = -0.5 * PI + Ghost_Timer * 0.001 * Ghost_RadarSweepRate * (2.0 * PI / 60.0);
    float da = angleDelta(a, sweepA);
    float sweep = (linePulse(da * max(r, 0.05), 0.010) + exp(-da * 14.0) * 0.22)
        * smoothstep(0.03, 0.10, r) * smoothstep(1.02, 0.92, r) * Ghost_RadarSweep * edge;
    return Ghost_Phosphor == 9 ? float3(grid * 0.55 + sweep * 1.7, grid * 0.35 + sweep * 0.45, 0.0)
                               : float3(grid + sweep, grid * 0.75 + sweep * 0.4, grid * 0.25);
}

float3 maskWeight(float2 uv)
{
    if (Ghost_MaskType == 0 || Ghost_MaskStrength <= 0.0 || Ghost_Phosphor >= 2 && Ghost_Phosphor != 12)
        return 1.0;
    float x = uv.x * BUFFER_WIDTH;
    // No fmod: vkBasalt's embedded FX compiler has no fmod intrinsic, and
    // floor-mod is the semantics we actually want (x is non-negative here).
    float xi = floor(x);
    float m = xi - 3.0 * floor(xi / 3.0);
    float3 slot = m < 1.0 ? float3(1, 0, 0) : (m < 2.0 ? float3(0, 1, 0) : float3(0, 0, 1));
    return lerp(float3(1.0, 1.0, 1.0), slot * 2.2, Ghost_MaskStrength);
}

float4 PresentPS(float4 pos : SV_Position, float2 uv0 : TEXCOORD) : SV_Target
{
    float2 uv = warpToTube(uv0);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
        return float4(float3(0.0035 * (1.0 - Ghost_GlassTint),
                             0.0035 * (1.0 - Ghost_GlassTint),
                             0.0035 * (1.0 - Ghost_GlassTint)), 1.0);

    float3 raster = sampleRaster(uv);
    // "vector" is a reserved word in vkBasalt's FX parser — keep it out.
    float3 stroke = sampleVector(uv);
    float3 light = lerp(raster, stroke, saturate(Ghost_VectorTrace));
    light += radarLight(uv);

    float2 px = float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);
    // Rotate the whole tap constellation per-pixel and per-frame, and sample
    // two radii. A fixed golden-angle ring at one radius resolves as discrete
    // ghost copies around a small bright source (the cursor) — the same
    // "12-cursor scatter" the GLSL halation kernel had before it was jittered.
    // Decorrelating the phase per pixel and frame lets the taps integrate
    // (spatially + in the eye) into the smooth halo the physics intends.
    float grot = hash12(pos.xy + Ghost_Timer * 0.017) * 6.2831853;
    float3 glow = 0.0;
    [unroll] for (int i = 0; i < 8; ++i) {
        float a = i * 2.39996 + grot;
        float2 d = float2(cos(a), sin(a));
        float r = (i < 4 ? 6.0 : 12.0);      // tight + wide skirt
        glow += tex2D(StateASampler, uv + d * px * r).rgb;
    }
    light += glow * (Ghost_Halation + Ghost_Diffusion) / 8.0;

    float3 emitted;
    if (Ghost_Phosphor == 9) {
        emitted = light.r * phosphorTint(9) + light.g * float3(0.517, 0.678, 0.101);
    } else if (Ghost_Phosphor >= 2 && Ghost_Phosphor != 12) {
        emitted = light.r * phosphorTint(Ghost_Phosphor);
    } else {
        emitted = light;
    }

    emitted *= maskWeight(uv0);
    emitted *= Ghost_GlassTint;

    float2 p = uv0 * 2.0 - 1.0;
    float bezel = 1.0 - Ghost_Bezel * smoothstep(0.82, 1.12, length(p));
    float2 q = abs(p) - (1.0 - Ghost_CornerRadius);
    float corner = 1.0 - smoothstep(-0.004, 0.002, length(max(q, float2(0.0, 0.0))) - Ghost_CornerRadius);
    emitted *= bezel * corner;
    emitted += 0.0035 * (1.0 - Ghost_GlassTint) * corner;

    if (Ghost_Noise > 0.0) {
        float n = hash12(pos.xy + Ghost_Timer * 0.001);
        emitted *= 1.0 + Ghost_Noise * 2.0 * (n - 0.5);
    }

    return float4(pow(saturate(emitted), 1.0 / 2.2), 1.0);
}

float4 CopyStatePS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    return tex2D(StateASampler, uv);
}

technique Ghostcrtty <
    ui_label = "ghostcrtty CRT";
    ui_tooltip = "Whole-screen CRT simulation with phosphor feedback, vector beam, and radar PPI overlay.";
>
{
    pass UpdatePhosphor
    {
        VertexShader = PostProcessVS;
        PixelShader = UpdateStatePS;
        RenderTarget = Ghost_StateA;
    }
    pass PresentTube
    {
        VertexShader = PostProcessVS;
        PixelShader = PresentPS;
    }
    pass RetainPhosphor
    {
        VertexShader = PostProcessVS;
        PixelShader = CopyStatePS;
        RenderTarget = Ghost_StateB;
    }
}
